---
// One hand-drawn glyph per week, keyed to that week's diplomatic term rather
// than to free-text `metaphor` frontmatter, so the mapping is exhaustive and
// stable (there are exactly twelve weeks, per course-config's own arc) rather
// than pattern-matching prose. No image-generation tool exists in this
// environment; every glyph here is a hand-authored SVG path, same technique
// as MyceliumMap's node markers.
interface Props {
  week: number;
  class?: string;
}

const { week, class: className } = Astro.props;

// stroke-only, viewBox 0 0 32 32, matching the line weight already
// established by MyceliumMap's node glyph — kept here so both draw from one
// visual vocabulary instead of two.
const GLYPHS: Record<number, string> = {
  // 1 Credentials — an ID card being checked
  1: `<rect x="5" y="9" width="22" height="16" rx="2.5" />
      <path d="M10 15.5 L13.5 19 L21 11.5" />`,
  // 2 Trade Agreements — carbon and nutrient exchanged both ways
  2: `<path d="M6 12 H22 M18 8 L22 12 L18 16" />
      <path d="M26 20 H10 M14 24 L10 20 L14 16" />`,
  // 3 Foreign Aid — carbon offered down to a stressed seedling
  3: `<path d="M16 4 V16" />
      <path d="M11 11 L16 16 L21 11" />
      <path d="M8 22 Q16 16 24 22" />
      <path d="M16 22 V28 M12 28 H20" />`,
  // 4 Espionage — a mycoheterotroph's eye, taking without paying
  4: `<path d="M4 16 Q16 6 28 16 Q16 26 4 16 Z" />
      <circle cx="16" cy="16" r="4.2" />`,
  // 5 Sanctions & Chemical Warfare — an allelopathic exclusion zone
  5: `<path d="M16 4 L27 10 V22 L16 28 L5 22 V10 Z" />
      <path d="M9 9 L23 23" />`,
  // 6 Double Agents — mutualist to one host, exploitative to another
  6: `<circle cx="12.5" cy="14" r="8" />
      <circle cx="19.5" cy="18" r="8" />`,
  // 7 Border Disputes — self / non-self recognition along a contested line
  7: `<path d="M16 3 V29" stroke-dasharray="1.2 3.4" />
      <circle cx="8" cy="12" r="2.4" />
      <circle cx="8" cy="20" r="2.4" />
      <circle cx="24" cy="12" r="2.4" />
      <circle cx="24" cy="20" r="2.4" />`,
  // 8 Refugee Crises — resource reallocation after disturbance
  8: `<path d="M5 22 Q16 26 27 14" />
      <circle cx="7" cy="21.5" r="1.7" />
      <circle cx="13" cy="23.3" r="1.7" />
      <circle cx="19" cy="21" r="1.7" />
      <path d="M22 10 L27 14 L23 18" />`,
  // 9 Arms Races — coevolving spore-spikes, crossed
  9: `<path d="M7 7 L25 25 M7 7 L9 12 M7 7 L12 9" />
      <path d="M25 7 L7 25 M25 7 L23 12 M25 7 L20 9" />`,
  // 10 Cold War & Détente — two networks facing, not yet fused
  10: `<path d="M9 10 Q4 16 9 22" />
       <path d="M23 10 Q28 16 23 22" />
       <path d="M13 16 H19" stroke-dasharray="1.6 2.4" />`,
  // 11 Treaties Broken — a seal split by a crack
  11: `<circle cx="16" cy="16" r="10" />
       <path d="M16 6 L13 15 L19 17 L14 26" />`,
  // 12 The Peace Conference — full fruiting bloom
  12: `<circle cx="16" cy="16" r="5" />
       <path d="M16 5 V9 M16 23 V27 M5 16 H9 M23 16 H27
                 M8.5 8.5 L11.2 11.2 M23.5 23.5 L20.8 20.8
                 M23.5 8.5 L20.8 11.2 M8.5 23.5 L11.2 20.8" />`,
};

const inner = GLYPHS[week] ?? GLYPHS[1];
---

<svg
  class={className}
  viewBox="0 0 32 32"
  aria-hidden="true"
  focusable="false"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  set:html={inner}
/>
