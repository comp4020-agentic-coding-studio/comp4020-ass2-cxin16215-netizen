---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";
import { formatCourseDate } from "../lib/dates";
import stainedRoot from "../decks/assets/amf-stained-root.jpg";
import lactarius from "../decks/assets/ecm-lactarius-pinus.jpg";

const assessments = await getPublishedCollection("assessments");
const visible = assessments.sort((a, b) => a.data.week - b.data.week);

const plates: Record<string, { src: ImageMetadata; alt: string; credit: string }> = {
  "field-dispatch": {
    src: stainedRoot,
    alt: "Stained arbuscular mycorrhizal structures inside a plant root, with a 50 micrometre scale bar.",
    credit: "Rajarshi Rit · CC BY 4.0 · Wikimedia Commons",
  },
  "the-peace-conference": {
    src: lactarius,
    alt: "Forked, swollen pine root tips sheathed by Lactarius deliciosus ectomycorrhizae.",
    credit: "Marc-André Selosse · CC0 · Wikimedia Commons",
  },
};
---

<div class="harvest-index">
  {
    visible.map((assessment) => {
      const plate = plates[assessment.id];
      return (
        <a class="harvest-plate" href={withBase(`/assessments/${assessment.id}/`)}>
          {plate && <Image src={plate.src} alt={plate.alt} widths={[768, 1536, 2400]} sizes="100vw" />}
          <span class="harvest-plate__weight">{assessment.data.weight}%</span>
          <div class="harvest-plate__body">
            <h2 class="harvest-plate__title">{assessment.data.title}</h2>
            <p class="harvest-plate__meta">
              Week {assessment.data.week} · Due {formatCourseDate(assessment.data.due)}
              {assessment.data.draft ? " · Draft" : ""}
            </p>
            {assessment.data.description && (
              <p class="harvest-plate__brief">{assessment.data.description}</p>
            )}
          </div>
          {plate && <p class="harvest-plate__credit">{plate.credit}</p>}
        </a>
      );
    })
  }
</div>
