---
interface Props {
  label: string;
  rotate?: number;
}

const { label, rotate = -4 } = Astro.props;
---

<span class="stamp" style={`--stamp-rotate: ${rotate}deg`}>{label}</span>

<style>
  .stamp {
    display: inline-block;
    font-family: var(--at-font-mono);
    font-size: var(--at-font-size-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.35em 0.8em;
    border: 3px double var(--at-primary);
    border-radius: 2px;
    background: color-mix(in oklch, var(--at-primary) 16%, transparent);
    color: var(--at-primary);
    transform: rotate(var(--stamp-rotate, -4deg));
    white-space: nowrap;
    box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--at-primary) 40%, transparent);
  }
</style>
