---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  credit: string;
}

const { src, alt, caption, credit } = Astro.props;
---

<figure class="soil-plate">
  <div class="soil-plate__frame">
    <Image
      src={src}
      alt={alt}
      widths={[640, 960, 1280]}
      sizes="(max-width: 60rem) 100vw, 60rem"
      quality={76}
      loading="lazy"
    />
  </div>
  <figcaption>
    <span class="soil-plate__caption">{caption}</span>
    <span class="soil-plate__credit">{credit}</span>
  </figcaption>
</figure>
