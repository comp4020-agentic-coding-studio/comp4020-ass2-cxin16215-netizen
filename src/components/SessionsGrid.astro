---
import { getPublishedCollection } from "astro-course-university/content";
import DossierIndex from "./DossierIndex.astro";
import { formatCourseDate } from "../lib/dates";

const sessions = await getPublishedCollection("sessions");
const visible = sessions.sort((a, b) => a.data.week - b.data.week);
---

<DossierIndex
  tone="strata"
  items={visible.map((session) => ({
    href: `/sessions/${session.id}/`,
    index: String(session.data.week).padStart(2, "0"),
    title: session.data.title,
    week: session.data.week,
    meta: `Week ${session.data.week} · ${formatCourseDate(session.data.date)}`,
    kicker: String(session.data.metaphor ?? ""),
    caption: String(session.data.phenomenon ?? session.data.description ?? ""),
  }))}
/>
