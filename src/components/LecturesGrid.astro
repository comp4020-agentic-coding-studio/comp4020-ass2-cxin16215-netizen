---
import { getPublishedCollection } from "astro-course-university/content";
import DossierIndex from "./DossierIndex.astro";
import { formatCourseDate } from "../lib/dates";

const lectures = await getPublishedCollection("lectures");
const visible = lectures.sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
---

<DossierIndex
  tone="spore"
  items={visible.map((lecture) => ({
    href: `/lectures/${lecture.id}/`,
    index: String(lecture.data.week).padStart(2, "0"),
    title: lecture.data.title,
    week: lecture.data.week,
    meta: `Week ${lecture.data.week} · ${formatCourseDate(lecture.data.date)}`,
    kicker: String(lecture.data.metaphor ?? ""),
    caption: String(lecture.data.phenomenon ?? lecture.data.description ?? ""),
  }))}
/>
