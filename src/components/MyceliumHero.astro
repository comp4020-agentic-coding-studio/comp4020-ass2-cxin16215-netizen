---
// The opening beat, restaged as one continuous camera move rather than a
// single static image: a mushroom forest, pulled in tight to one cap's
// gills, pulled in tighter again to the hyphae threading through them —
// which then hand off directly into <MyceliumMap>, the actual "complete
// underground world" the threads lead to. No image-generation or browser
// tool exists in this environment, so every scene below is hand-authored
// SVG line/shape art, not a photograph or a rendered illustration.
//
// The three scenes are pinned in one sticky viewport-height stage while a
// tall spacer (`--myco-hero-vh`) scrolls underneath it; a small script
// turns scroll position inside that spacer into three 0..1 weights (one
// per scene) and sets them as CSS custom properties the scenes read for
// opacity and scale. Reduced motion drops the spacer to one viewport and
// shows only the cap/gills scene, statically — the same single hero image
// this component used to be, unchanged for anyone who has asked for less
// motion.
interface Props {
  code: string;
  title: string;
  tagline: string;
  mapAnchorId: string;
}

const { code, title, tagline, mapAnchorId } = Astro.props;

// --- Scene A: forest, wide shot -------------------------------------------
// Nine mushrooms in three depth bands (back/mid/front), painted back-to-
// front, each dimmer and smaller the further back it sits — the classic
// layered-silhouette depth cue, done with plain ellipses so it costs
// nothing to hand-place.
const GROUND_Y = 360;
const mushrooms = Array.from({ length: 9 }, (_, i) => {
  const depth = i % 3;
  const scale = depth === 0 ? 0.5 : depth === 1 ? 0.78 : 1.15;
  const x = 40 + i * 90 + (((i * 53) % 40) - 20);
  const y = GROUND_Y - ((i * 29) % 18);
  return {
    x,
    y,
    capRx: 46 * scale,
    capRy: 24 * scale,
    stemW: 9 * scale,
    stemH: 52 * scale,
    depth,
  };
}).sort((a, b) => a.depth - b.depth);

// --- Scene B: one cap, seen from underneath -------------------------------
// Concentric ridges plus sixteen radiating gills, most forking once near
// the rim — the same "branch, don't just extend" logic MyceliumMap uses
// for its trunk offshoots, applied radially. Composited four times through
// <use> at rising blur/falling opacity to fake volumetric glow.
const GILL_COUNT = 16;
const gills = Array.from({ length: GILL_COUNT }, (_, i) => {
  const angle = (i / GILL_COUNT) * Math.PI * 2 + (i % 2 === 0 ? 0.05 : -0.05);
  const innerR = 92;
  const outerR = 210 + ((i * 37) % 60);
  const midR = (innerR + outerR) / 2 + ((i * 19) % 24);
  const wobble = ((i * 53) % 40) - 20;
  const x1 = 300 + Math.cos(angle) * innerR;
  const y1 = 300 + Math.sin(angle) * innerR;
  const xm = 300 + Math.cos(angle) * midR + Math.cos(angle + Math.PI / 2) * wobble * 0.3;
  const ym = 300 + Math.sin(angle) * midR + Math.sin(angle + Math.PI / 2) * wobble * 0.3;
  const x2 = 300 + Math.cos(angle) * outerR;
  const y2 = 300 + Math.sin(angle) * outerR;
  const forkAngle = angle + (i % 2 === 0 ? 0.5 : -0.5);
  const forkR = outerR - 34;
  const fx = 300 + Math.cos(forkAngle) * forkR;
  const fy = 300 + Math.sin(forkAngle) * forkR;
  return { d: `M ${x1} ${y1} Q ${xm} ${ym} ${x2} ${y2} M ${xm} ${ym} L ${fx} ${fy}` };
});

// --- Scene C: among the hyphae ---------------------------------------------
// Fourteen filaments entering from all four edges of a tight 400x400 frame,
// crossing near the middle and forking once past it — a close, immersive
// tangle rather than a centred motif, so the zoom reads as "inside" the
// structure rather than "looking at another icon."
const filaments = Array.from({ length: 14 }, (_, i) => {
  const edge = i % 4;
  const t = ((i * 41) % 100) / 100;
  const along = t * 400;
  const [x1, y1] = edge === 0 ? [along, -20] : edge === 1 ? [420, along] : edge === 2 ? [along, 420] : [-20, along];
  const cx = 200 + (((i * 37) % 160) - 80);
  const cy = 200 + (((i * 53) % 160) - 80);
  const x2 = 400 - x1 + (((i * 19) % 60) - 30);
  const y2 = 400 - y1 + (((i * 23) % 60) - 30);
  const fx = cx + (x2 - cx) * 0.6;
  const fy = cy + (y2 - cy) * 0.6;
  const bx = fx + (((i * 31) % 50) - 25);
  const by = fy + (((i * 17) % 50) - 25);
  return { d: `M ${x1} ${y1} Q ${cx} ${cy} ${x2} ${y2} M ${fx} ${fy} L ${bx} ${by}` };
});
---

<section class="myco-hero" aria-label={title}>
  <div class="myco-hero__stage-wrap">
    <div class="myco-hero__stage" id="myco-hero-stage">
      <svg
        class="myco-hero__scene myco-hero__scene--forest"
        viewBox="0 0 800 400"
        preserveAspectRatio="xMidYMid slice"
        aria-hidden="true"
        focusable="false"
      >
        <rect x="0" y={GROUND_Y + 6} width="800" height={400 - GROUND_Y - 6} class="myco-forest__ground" />
        {
          mushrooms.map((m) => (
            <g class={`myco-forest__mushroom myco-forest__mushroom--d${m.depth}`}>
              <rect x={m.x - m.stemW / 2} y={m.y - m.stemH} width={m.stemW} height={m.stemH} rx={m.stemW / 2} />
              <ellipse cx={m.x} cy={m.y - m.stemH} rx={m.capRx} ry={m.capRy} />
            </g>
          ))
        }
      </svg>

      <svg
        class="myco-hero__scene myco-hero__scene--cap"
        viewBox="0 0 600 600"
        aria-hidden="true"
        focusable="false"
      >
        <defs>
          <g id="myco-gill-art" fill="none" stroke="currentColor" stroke-linecap="round">
            <circle cx="300" cy="300" r="40" stroke-width="1.4" opacity="0.9" />
            <circle cx="300" cy="300" r="66" stroke-width="1.1" opacity="0.6" />
            <circle cx="300" cy="300" r="92" stroke-width="1.6" opacity="0.75" />
            <circle cx="300" cy="300" r="150" stroke-width="0.8" opacity="0.35" stroke-dasharray="1.5 7" />
            {gills.map((g) => (
              <path d={g.d} stroke-width="1.3" opacity="0.7" />
            ))}
          </g>
        </defs>
        <use href="#myco-gill-art" class="myco-cap__layer myco-cap__layer--3" />
        <use href="#myco-gill-art" class="myco-cap__layer myco-cap__layer--2" />
        <use href="#myco-gill-art" class="myco-cap__layer myco-cap__layer--1" />
        <use href="#myco-gill-art" class="myco-cap__layer myco-cap__layer--core" />
      </svg>

      <svg
        class="myco-hero__scene myco-hero__scene--hyphae"
        viewBox="0 0 400 400"
        preserveAspectRatio="xMidYMid slice"
        aria-hidden="true"
        focusable="false"
      >
        <g fill="none" stroke="currentColor" stroke-linecap="round">
          {filaments.map((f) => (
            <path d={f.d} stroke-width="1.6" opacity="0.75" />
          ))}
        </g>
      </svg>

      <div class="myco-hero__content">
        <p class="myco-hero__code">{code}</p>
        <h1 class="myco-hero__title">{title}</h1>
        <p class="myco-hero__tagline">{tagline}</p>
      </div>

      <a href={`#${mapAnchorId}`} class="myco-hero__descend">
        <span class="myco-hero__descend-arrow" aria-hidden="true">↓</span>
        Descend into the network
      </a>
    </div>
  </div>
</section>

<script>
  // Turns scroll position inside the tall spacer into three independent
  // 0..1 weights, one per scene, plus a matching scale for each so a
  // fading scene visibly grows (the camera flying past it) while an
  // arriving scene visibly grows too (the camera arriving at it). Skipped
  // entirely under reduced motion: the CSS fallback shows the cap scene
  // statically and nothing here needs to run.
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)");

  function clamp01(n: number) {
    return Math.min(1, Math.max(0, n));
  }

  function smoothstep(edge0: number, edge1: number, x: number) {
    const t = clamp01((x - edge0) / (edge1 - edge0));
    return t * t * (3 - 2 * t);
  }

  function lerp(a: number, b: number, t: number) {
    return a + (b - a) * t;
  }

  if (!reduceMotion.matches) {
    const wrap = document.querySelector<HTMLElement>(".myco-hero__stage-wrap");
    const stage = document.getElementById("myco-hero-stage");
    let ticking = false;

    function update() {
      ticking = false;
      if (!wrap || !stage) return;
      const rect = wrap.getBoundingClientRect();
      const scrollable = rect.height - window.innerHeight;
      const progress = scrollable > 0 ? clamp01(-rect.top / scrollable) : 0;

      const forestW = 1 - smoothstep(0, 0.3, progress);
      const capW = smoothstep(0.12, 0.32, progress) - smoothstep(0.55, 0.75, progress);
      const hyphaeW = smoothstep(0.62, 0.88, progress);

      stage.style.setProperty("--o-forest", String(forestW));
      stage.style.setProperty("--s-forest", String(lerp(1, 1.6, 1 - forestW)));
      stage.style.setProperty("--o-cap", String(clamp01(capW)));
      stage.style.setProperty(
        "--s-cap",
        String(progress < 0.4 ? lerp(0.7, 1, smoothstep(0.12, 0.32, progress)) : lerp(1, 1.5, smoothstep(0.55, 0.75, progress))),
      );
      stage.style.setProperty("--o-hyphae", String(hyphaeW));
      stage.style.setProperty("--s-hyphae", String(lerp(0.75, 1.05, hyphaeW)));
      stage.style.setProperty("--o-content", String(1 - smoothstep(0, 0.22, progress)));
    }

    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    }

    update();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
  }
</script>

<style>
  .myco-hero__stage-wrap {
    position: relative;
    height: var(--myco-hero-vh, 300vh);
  }

  .myco-hero__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    display: grid;
    place-items: center;
    isolation: isolate;
  }

  .myco-hero__scene {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* Scene A: forest. Grows and fades as scroll progresses — the camera
     appears to fly forward through it. */
  .myco-hero__scene--forest {
    opacity: var(--o-forest, 1);
    transform: scale(var(--s-forest, 1));
    color: var(--myco-glow);
  }

  .myco-forest__ground {
    fill: var(--myco-fog-2);
  }

  .myco-forest__mushroom {
    fill: var(--myco-glow-2);
  }

  .myco-forest__mushroom--d0 {
    opacity: 0.32;
    filter: blur(1.5px);
  }

  .myco-forest__mushroom--d1 {
    opacity: 0.55;
    fill: var(--myco-glow);
  }

  .myco-forest__mushroom--d2 {
    opacity: 0.9;
    fill: var(--myco-glow);
    filter: drop-shadow(0 0 10px var(--myco-glow-soft));
  }

  /* Scene B: the cap's underside. Rises in, grows past 40% progress the
     same way the forest grows — the camera arriving, then flying through. */
  .myco-hero__scene--cap {
    opacity: var(--o-cap, 0);
    transform: scale(var(--s-cap, 0.7));
  }

  .myco-hero__scene--cap {
    color: var(--myco-glow);
  }

  .myco-cap__layer--3 {
    filter: blur(22px);
    opacity: 0.35;
    color: var(--myco-glow-2);
  }

  .myco-cap__layer--2 {
    filter: blur(10px);
    opacity: 0.55;
  }

  .myco-cap__layer--1 {
    filter: blur(3px);
    opacity: 0.8;
  }

  .myco-cap__layer--core {
    opacity: 0.95;
    color: var(--myco-glow-2);
  }

  /* Scene C: among the hyphae. Rises in and settles — this is where the
     pinned sequence ends and <MyceliumMap> takes over directly below. */
  .myco-hero__scene--hyphae {
    opacity: var(--o-hyphae, 0);
    transform: scale(var(--s-hyphae, 0.75));
    color: var(--myco-glow-2);
  }

  .myco-hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--at-spacing-sm);
    max-width: 44rem;
    padding-inline: var(--at-spacing-lg);
    text-align: center;
    opacity: var(--o-content, 1);
  }

  .myco-hero__code {
    margin: 0;
    font-family: var(--at-font-mono);
    font-size: var(--at-font-size-sm);
    font-weight: 700;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--myco-glow);
    opacity: 0.85;
  }

  .myco-hero__title {
    margin: 0;
    font-family: var(--myco-font-display);
    font-size: clamp(2.25rem, 6vw, 4.75rem);
    font-weight: 600;
    line-height: 1.05;
    color: var(--at-text);
    text-wrap: balance;
    text-shadow:
      0 0 30px var(--myco-glow-soft),
      0 0 90px var(--myco-glow-soft);
  }

  .myco-hero__tagline {
    margin: 0;
    max-width: 34rem;
    font-size: var(--at-font-size-md);
    color: var(--at-text-secondary);
  }

  .myco-hero__descend {
    position: absolute;
    z-index: 1;
    bottom: var(--at-spacing-xl);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--at-font-mono);
    font-size: var(--at-font-size-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--at-text-secondary);
    text-decoration: none;
    opacity: var(--o-content, 1);
    transition: color 0.2s ease;
  }

  .myco-hero__descend:hover,
  .myco-hero__descend:focus-visible {
    color: var(--myco-glow);
  }

  .myco-hero__descend-arrow {
    font-size: 1.25rem;
    animation: myco-descend-bob 1.8s ease-in-out infinite;
  }

  @keyframes myco-descend-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(0.35rem);
    }
  }

  /* The pre-scroll-jacking hero, unchanged: cap/gills only, static, no
     spacer. Anyone who has asked for less motion gets exactly the single
     image this component used to show, not a cut-down version of the zoom. */
  @media (prefers-reduced-motion: reduce) {
    .myco-hero__stage-wrap {
      height: 100svh;
    }

    .myco-hero__stage {
      position: static;
    }

    .myco-hero__scene--forest,
    .myco-hero__scene--hyphae {
      display: none;
    }

    .myco-hero__scene--cap {
      opacity: 1;
      transform: none;
    }

    .myco-hero__content,
    .myco-hero__descend {
      opacity: 1;
    }

    .myco-hero__descend-arrow {
      animation: none;
    }
  }

</style>
