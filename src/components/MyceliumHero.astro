---
// The opening beat, restaged as one continuous camera move rather than a
// single static image: a forest floor, pulled down through the wall of soil
// at its edge, deeper still to the root hub the whole network answers to —
// which then hands off directly into <MyceliumMap>, the actual "complete
// underground world" the threads lead to. No image-generation or browser
// tool exists in this environment, so every scene below is hand-authored
// SVG line/shape art, not a photograph or a rendered illustration — and the
// brief this redesign answers is specifically "mushroom and soil," so every
// new shape (strata walls, tubers, root hairs, rocks, groundwater, burrowed
// fauna) is drawn from that vocabulary rather than the glow duo alone.
//
// The three scenes — Surface, Threshold, Undersoil — are pinned in one
// sticky viewport-height stage while a tall spacer (`--myco-hero-vh`)
// scrolls underneath it; a small script turns scroll position inside that
// spacer into three 0..1 weights (one per scene) and sets them as CSS custom
// properties the scenes read for opacity and scale. Reduced motion drops the
// spacer to one viewport and shows only the Threshold scene, statically —
// the same single hero image this component used to be, unchanged for
// anyone who has asked for less motion.
//
// Layered on top of that (still SVG/CSS): a progressively-enhanced WebGL
// pass. The SVG scenes above are not a stopgap — they are the real fallback,
// served to everyone by default and to anyone on reduced motion or a
// WebGL2-less browser permanently. When a capable, motion-tolerant browser
// loads the page, a client script feature-detects WebGL2, and only then
// dynamically imports `three` (a real npm dependency, not a CDN asset) to
// build one continuous 3D dolly through a procedurally-grown forest, under
// one cap, into its gills and the hyphae beyond, lit with real point/emissive
// lighting and an UnrealBloomPass for the glow no CSS filter can match. The
// geometry is generated the same way the SVG paths above are — hashed index
// arithmetic, not `Math.random()`, so a given build is reproducible — never
// an imported 3D model or texture, per the same "grown from this course's
// own system" rule CLAUDE.md holds the SVG sigils to. Exact exposure/bloom
// tuning below is an eyeballed guess: there is still no browser in this
// session to look at it in.
interface Props {
  code: string;
  title: string;
  tagline: string;
  mapAnchorId: string;
}

const { code, title, tagline, mapAnchorId } = Astro.props;

// Deterministic pseudo-random-ish jitter: every shape below is placed with
// this, never `Math.random()`, so a given build is always the same shape.
function hash(i: number, k: number): number {
  return ((i * k) % 97) / 97;
}

const SCENE_W = 700;

// A wobbly horizontal line (soil surface, strata seam) built from
// `segments` hashed control points, smoothed with quadratic-Bezier
// midpoints so it reads as an uneven, organic boundary rather than a ruled
// cut. Returns the points alongside the path data since one caller
// (root-hair ticks) needs to hang perpendicular marks off those same points.
function groundLine(width: number, amplitude: number, segments: number, seed: number) {
  const step = width / segments;
  const points = Array.from({ length: segments + 1 }, (_, i) => ({
    x: i * step,
    y: (hash(i + seed, 13) - 0.5) * amplitude,
  }));
  let d = `M ${points[0]!.x} ${points[0]!.y}`;
  for (let i = 1; i < points.length; i++) {
    const prev = points[i - 1]!;
    const cur = points[i]!;
    const midX = (prev.x + cur.x) / 2;
    const midY = (prev.y + cur.y) / 2 + (hash(i + seed, 29) - 0.5) * amplitude * 0.7;
    d += ` Q ${midX} ${midY} ${cur.x} ${cur.y}`;
  }
  return { d, points };
}

// Shared verbatim between Surface and Threshold — the ground line the
// camera crosses has to look like the same line on both sides of the cut.
const groundLineArt = groundLine(SCENE_W, 16, 10, 0);
const rootHairTicks = groundLineArt.points
  .filter((_, i) => i % 2 === 1)
  .map((p, j) => ({
    x1: p.x,
    y1: p.y,
    x2: p.x + (hash(j, 19) - 0.5) * 5,
    y2: p.y + 5 + hash(j, 31) * 6,
  }));

// A tangle of filaments entering from all four edges of a w×h frame,
// crossing near the middle and forking once past it. Used both for the
// matte root-hair layer and, composited four times through <use> at rising
// blur/falling opacity, the glowing hyphae layer — in both Threshold and
// Undersoil.
function filamentField(count: number, w: number, h: number, seed: number) {
  return Array.from({ length: count }, (_, i) => {
    const k = i + seed;
    const edge = k % 4;
    const t = ((k * 41) % 100) / 100;
    const alongW = t * w;
    const alongH = t * h;
    const [x1, y1] =
      edge === 0 ? [alongW, -20] : edge === 1 ? [w + 20, alongH] : edge === 2 ? [alongW, h + 20] : [-20, alongH];
    const cx = w / 2 + (((k * 37) % (w * 0.4)) - w * 0.2);
    const cy = h / 2 + (((k * 53) % (h * 0.4)) - h * 0.2);
    const x2 = w - x1 + (((k * 19) % 60) - 30);
    const y2 = h - y1 + (((k * 23) % 60) - 30);
    const fx = cx + (x2 - cx) * 0.6;
    const fy = cy + (y2 - cy) * 0.6;
    const bx = fx + (((k * 31) % 50) - 25);
    const by = fy + (((k * 17) % 50) - 25);
    return { d: `M ${x1} ${y1} Q ${cx} ${cy} ${x2} ${y2} M ${fx} ${fy} L ${bx} ${by}` };
  });
}

// A fan of root tendrils radiating from one origin between two angles — the
// tuber growths in Threshold's wall and Undersoil's central hub.
function rootTendrils(count: number, originX: number, originY: number, spreadAngle0: number, spreadAngle1: number, seed: number) {
  return Array.from({ length: count }, (_, i) => {
    const k = i + seed;
    const angle =
      spreadAngle0 + (spreadAngle1 - spreadAngle0) * (i / Math.max(1, count - 1)) + (hash(k, 31) - 0.5) * 0.4;
    const len = 60 + hash(k, 17) * 100;
    const midLen = len * 0.55;
    const wob = (hash(k, 29) - 0.5) * 36;
    const mx = originX + Math.cos(angle) * midLen - Math.sin(angle) * wob;
    const my = originY + Math.sin(angle) * midLen + Math.cos(angle) * wob;
    const ex = originX + Math.cos(angle) * len;
    const ey = originY + Math.sin(angle) * len;
    return { d: `M ${originX} ${originY} Q ${mx} ${my} ${ex} ${ey}` };
  });
}

// A closed, jittered blob outline — the tuber/groundwater shape language,
// smoothed the same way groundLine is, just wrapped into a loop.
function blobPath(cx: number, cy: number, rx: number, ry: number, points: number, seed: number) {
  const pts = Array.from({ length: points }, (_, i) => {
    const a = (i / points) * Math.PI * 2;
    const jitter = 0.82 + hash(i + seed, 23) * 0.36;
    return { x: cx + Math.cos(a) * rx * jitter, y: cy + Math.sin(a) * ry * jitter };
  });
  let d = `M ${pts[0]!.x} ${pts[0]!.y}`;
  for (let i = 0; i < pts.length; i++) {
    const p0 = pts[i]!;
    const p1 = pts[(i + 1) % pts.length]!;
    const mx = (p0.x + p1.x) / 2 + (hash(i + seed, 31) - 0.5) * 8;
    const my = (p0.y + p1.y) / 2 + (hash(i + seed, 41) - 0.5) * 8;
    d += ` Q ${mx} ${my} ${p1.x} ${p1.y}`;
  }
  return `${d} Z`;
}

// A jittered N-gon outline for rocks — same hashed-jitter idea as
// blobPath, but a raw point list for a <polygon> rather than a smoothed
// path, since a rock should read as faceted, not organic.
function rockPoints(cx: number, cy: number, r: number, sides: number, seed: number) {
  return Array.from({ length: sides }, (_, i) => {
    const a = (i / sides) * Math.PI * 2;
    const jitter = 0.65 + hash(i + seed, 19) * 0.55;
    return `${(cx + Math.cos(a) * r * jitter).toFixed(1)},${(cy + Math.sin(a) * r * jitter).toFixed(1)}`;
  }).join(" ");
}

// --- Scene: Surface --------------------------------------------------------
// A forest floor at the soil line: mushrooms above, root hairs already
// reaching down into the ground line below them — the "mushroom and soil"
// handoff stated up front, before the camera ever descends.
const SURFACE_H = 400;
const SURFACE_GROUND_Y = 322;
const surfaceMushrooms = Array.from({ length: 6 }, (_, i) => {
  const scale = 0.9 + hash(i, 23) * 0.65;
  return {
    x: 55 + i * 118 + (hash(i, 41) - 0.5) * 46,
    y: SURFACE_GROUND_Y - hash(i, 17) * 22,
    capRx: 50 * scale,
    capRy: 27 * scale,
    stemW: 11 * scale,
    stemH: 74 * scale,
    glow: (i * 3) % 2 === 0 ? "teal" : "violet",
  };
});
const surfaceFlecks = Array.from({ length: 4 }, (_, i) => ({
  x: 90 + i * 150 + (hash(i, 31) - 0.5) * 60,
  y: SURFACE_GROUND_Y + 14 + hash(i, 19) * 30,
  r: 1.8 + hash(i, 11) * 2.2,
}));
const surfaceAnt = { x: 260, y: SURFACE_GROUND_Y + 20, flip: false };

// --- Scene: Threshold -------------------------------------------------------
// The wall of soil itself, seen in cross-section: three strata bands, a
// tuber pushing tendrils into the dirt, root hairs and glowing hyphae
// threading between them, and the first burrowed fauna. This is where "soil"
// stops being a colour under the mushrooms and becomes the whole frame.
const THRESHOLD_H = 620;
const strataBoundaryY1 = 190;
const strataBoundaryY2 = 400;
const strataLine1 = groundLine(SCENE_W, 12, 8, 11);
const strataLine2 = groundLine(SCENE_W, 12, 8, 47);
const tuberX = 350;
const tuberY = 470;
const tuberPath = blobPath(tuberX, tuberY, 46, 60, 9, 5);
const tuberTendrils = rootTendrils(7, tuberX, tuberY - 30, -2.6, -0.5, 3);
const thresholdGlowFilaments = filamentField(9, SCENE_W, THRESHOLD_H, 61);
const thresholdRootHairs = filamentField(7, SCENE_W, THRESHOLD_H, 83);
const burrows = [
  { x: 90, y: 240, rx: 22, ry: 14, fauna: "worm" as const },
  { x: 590, y: 340, rx: 20, ry: 13, fauna: "beetle" as const },
];
const moistureBeads = Array.from({ length: 3 }, (_, i) => ({
  x: 150 + i * 190 + (hash(i, 29) - 0.5) * 50,
  y: 260 + i * 60 + (hash(i, 37) - 0.5) * 40,
  r: 5 + hash(i, 13) * 3,
}));
const thresholdForegroundFlecks = Array.from({ length: 4 }, (_, i) => ({
  x: 60 + i * 190 + (hash(i, 43) - 0.5) * 40,
  y: 560 + (hash(i, 17) - 0.5) * 24,
  r: 1.4 + hash(i, 7) * 1.6,
}));

// --- Scene: Undersoil -------------------------------------------------------
// The deepest point of the dive: bedrock, groundwater, and the hub tuber the
// whole visible network answers to, tangled in root hairs and glowing
// hyphae — the frame that hands off directly into <MyceliumMap> below.
const UNDERSOIL_H = 620;
const rocks = Array.from({ length: 4 }, (_, i) => ({
  points: rockPoints(
    120 + i * 160 + (hash(i, 31) - 0.5) * 60,
    480 + (hash(i, 23) - 0.5) * 80,
    34 + hash(i, 17) * 22,
    6 + (i % 3),
    i * 7 + 5,
  ),
}));
const waterCx = 520;
const waterCy = 200;
const waterRx = 90;
const waterRy = 46;
const waterPath = blobPath(waterCx, waterCy, waterRx, waterRy, 10, 71);
const waterArcPath = `M ${waterCx - waterRx * 0.7} ${waterCy - waterRy * 0.4} Q ${waterCx} ${waterCy - waterRy * 0.9} ${waterCx + waterRx * 0.7} ${waterCy - waterRy * 0.4}`;
const hubX = 260;
const hubY = 420;
const hubPath = blobPath(hubX, hubY, 58, 66, 10, 91);
const hubTendrils = rootTendrils(8, hubX, hubY, 0, Math.PI * 2 * 0.999, 13);
const undersoilGlowFilaments = filamentField(14, SCENE_W, UNDERSOIL_H, 109);
const undersoilRootHairs = filamentField(10, SCENE_W, UNDERSOIL_H, 137);
const undersoilFlecks = Array.from({ length: 22 }, (_, i) => ({
  x: hash(i, 53) * SCENE_W,
  y: hash(i, 47) * UNDERSOIL_H,
  r: 1 + hash(i, 11) * 1.8,
}));
const undersoilAnt = { x: 470, y: 540, flip: true };
const undersoilGrub = { x: 180, y: 300 };
---

<section class="myco-hero" aria-label={title}>
  <div class="myco-hero__stage-wrap">
    <div class="myco-hero__stage" id="myco-hero-stage">
      <svg
        class="myco-hero__scene myco-hero__scene--surface"
        viewBox={`0 0 ${SCENE_W} ${SURFACE_H}`}
        preserveAspectRatio="xMidYMid slice"
        aria-hidden="true"
        focusable="false"
      >
        <rect x="0" y="0" width={SCENE_W} height={SURFACE_H} class="myco-surface__sky" />
        <rect x="0" y={SURFACE_GROUND_Y} width={SCENE_W} height={SURFACE_H - SURFACE_GROUND_Y} class="myco-surface__soil" />
        {
          surfaceMushrooms.map((m) => (
            <g class={`myco-surface__mushroom myco-surface__mushroom--${m.glow}`}>
              <rect x={m.x - m.stemW / 2} y={m.y - m.stemH} width={m.stemW} height={m.stemH} rx={m.stemW / 2} class="myco-surface__stem" />
              <ellipse cx={m.x} cy={m.y - m.stemH} rx={m.capRx} ry={m.capRy} class="myco-surface__cap" />
            </g>
          ))
        }
        <g transform={`translate(0 ${SURFACE_GROUND_Y})`}>
          {
            rootHairTicks.map((t) => (
              <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} class="myco-root-hair-tick" />
            ))
          }
          <path d={groundLineArt.d} class="myco-ground-line" />
        </g>
        {
          surfaceFlecks.map((f) => (
            <use href="#myco-fauna-fleck" x={f.x - f.r} y={f.y - f.r} width={f.r * 2} height={f.r * 2} class="mm-detritus" />
          ))
        }
        <g transform={`translate(${surfaceAnt.x} ${surfaceAnt.y}) scale(${surfaceAnt.flip ? -1 : 1}, 1)`}>
          <use href="#myco-fauna-ant" x="-10" y="-5" width="20" height="10" class="mm-ant" />
        </g>
      </svg>

      <svg
        class="myco-hero__scene myco-hero__scene--threshold"
        viewBox={`0 0 ${SCENE_W} ${THRESHOLD_H}`}
        preserveAspectRatio="xMidYMid slice"
        aria-hidden="true"
        focusable="false"
      >
        <defs>
          <radialGradient id="myco-moisture-grad">
            <stop offset="0%" class="myco-moisture-grad__inner" />
            <stop offset="100%" class="myco-moisture-grad__outer" />
          </radialGradient>
          <g id="myco-hyphae-art-threshold" fill="none" stroke="currentColor" stroke-linecap="round">
            {
              thresholdGlowFilaments.map((f) => (
                <path d={f.d} stroke-width="1.5" opacity="0.75" />
              ))
            }
          </g>
        </defs>

        <rect x="0" y="0" width={SCENE_W} height={strataBoundaryY1} class="myco-threshold__wall myco-threshold__wall--1" />
        <rect x="0" y={strataBoundaryY1} width={SCENE_W} height={strataBoundaryY2 - strataBoundaryY1} class="myco-threshold__wall myco-threshold__wall--2" />
        <rect x="0" y={strataBoundaryY2} width={SCENE_W} height={THRESHOLD_H - strataBoundaryY2} class="myco-threshold__wall myco-threshold__wall--3" />

        <path d={groundLineArt.d} class="myco-ground-line" />
        <g transform={`translate(0 ${strataBoundaryY1})`}>
          <path d={strataLine1.d} class="myco-strata-seam" />
        </g>
        <g transform={`translate(0 ${strataBoundaryY2})`}>
          <path d={strataLine2.d} class="myco-strata-seam" />
        </g>

        <g fill="none" stroke="currentColor" stroke-linecap="round" class="myco-root-hair">
          {
            thresholdRootHairs.map((f) => (
              <path d={f.d} stroke-width="1.2" opacity="0.5" />
            ))
          }
        </g>

        <use href="#myco-hyphae-art-threshold" class="myco-hyphae-layer myco-hyphae-layer--3" />
        <use href="#myco-hyphae-art-threshold" class="myco-hyphae-layer myco-hyphae-layer--2" />
        <use href="#myco-hyphae-art-threshold" class="myco-hyphae-layer myco-hyphae-layer--1" />
        <use href="#myco-hyphae-art-threshold" class="myco-hyphae-layer myco-hyphae-layer--core" />

        <g class="myco-tuber">
          {
            tuberTendrils.map((t) => (
              <g>
                <path d={t.d} class="myco-root-tendril__layer myco-root-tendril__layer--1" />
                <path d={t.d} class="myco-root-tendril__layer myco-root-tendril__layer--2" />
                <path d={t.d} class="myco-root-tendril__layer myco-root-tendril__layer--3" />
              </g>
            ))
          }
          <path d={tuberPath} class="myco-tuber__body" />
        </g>

        {
          burrows.map((b) => (
            <g>
              <ellipse cx={b.x} cy={b.y} rx={b.rx} ry={b.ry} class="myco-burrow" />
              {b.fauna === "worm" ? (
                <use href="#myco-fauna-worm" x={b.x - 15} y={b.y - 5} width="30" height="10" class="mm-worm" />
              ) : (
                <use href="#myco-fauna-beetle" x={b.x - 11} y={b.y - 7} width="22" height="14" class="mm-beetle" />
              )}
            </g>
          ))
        }

        {
          moistureBeads.map((m) => (
            <circle cx={m.x} cy={m.y} r={m.r} fill="url(#myco-moisture-grad)" />
          ))
        }

        <g class="myco-threshold__fg-blur">
          {
            thresholdForegroundFlecks.map((f) => (
              <use href="#myco-fauna-fleck" x={f.x - f.r} y={f.y - f.r} width={f.r * 2} height={f.r * 2} class="mm-detritus" />
            ))
          }
        </g>
      </svg>

      <svg
        class="myco-hero__scene myco-hero__scene--undersoil"
        viewBox={`0 0 ${SCENE_W} ${UNDERSOIL_H}`}
        preserveAspectRatio="xMidYMid slice"
        aria-hidden="true"
        focusable="false"
      >
        <defs>
          <g id="myco-hyphae-art-undersoil" fill="none" stroke="currentColor" stroke-linecap="round">
            {
              undersoilGlowFilaments.map((f) => (
                <path d={f.d} stroke-width="1.5" opacity="0.75" />
              ))
            }
          </g>
        </defs>

        <rect x="0" y="0" width={SCENE_W} height={UNDERSOIL_H} class="myco-undersoil__bg" />

        {
          rocks.map((r) => (
            <polygon points={r.points} class="myco-rock" />
          ))
        }

        <path d={waterPath} class="myco-water-body" />
        <path d={waterArcPath} class="myco-water-specular" />

        <g fill="none" stroke="currentColor" stroke-linecap="round" class="myco-root-hair">
          {
            undersoilRootHairs.map((f) => (
              <path d={f.d} stroke-width="1.2" opacity="0.5" />
            ))
          }
        </g>

        <use href="#myco-hyphae-art-undersoil" class="myco-hyphae-layer myco-hyphae-layer--3" />
        <use href="#myco-hyphae-art-undersoil" class="myco-hyphae-layer myco-hyphae-layer--2" />
        <use href="#myco-hyphae-art-undersoil" class="myco-hyphae-layer myco-hyphae-layer--1" />
        <use href="#myco-hyphae-art-undersoil" class="myco-hyphae-layer myco-hyphae-layer--core" />

        <g class="myco-tuber myco-tuber--hub">
          {
            hubTendrils.map((t) => (
              <g>
                <path d={t.d} class="myco-root-tendril__layer myco-root-tendril__layer--1" />
                <path d={t.d} class="myco-root-tendril__layer myco-root-tendril__layer--2" />
                <path d={t.d} class="myco-root-tendril__layer myco-root-tendril__layer--3" />
              </g>
            ))
          }
          <path d={hubPath} class="myco-tuber__body" />
        </g>

        {
          undersoilFlecks.map((f) => (
            <use href="#myco-fauna-fleck" x={f.x - f.r} y={f.y - f.r} width={f.r * 2} height={f.r * 2} class="mm-detritus" />
          ))
        }

        <g transform={`translate(${undersoilAnt.x} ${undersoilAnt.y}) scale(${undersoilAnt.flip ? -1 : 1}, 1)`}>
          <use href="#myco-fauna-ant" x="-10" y="-5" width="20" height="10" class="mm-ant" />
        </g>
        <use href="#myco-fauna-grub" x={undersoilGrub.x - 8} y={undersoilGrub.y - 8} width="16" height="16" class="mm-grub" />
      </svg>

      <canvas id="myco-hero-canvas" class="myco-hero__canvas" aria-hidden="true"></canvas>

      <div class="myco-hero__content">
        <p class="myco-hero__code">{code}</p>
        <h1 class="myco-hero__title">{title}</h1>
        <p class="myco-hero__tagline">{tagline}</p>
      </div>

      <a href={`#${mapAnchorId}`} class="myco-hero__descend">
        <span class="myco-hero__descend-arrow" aria-hidden="true">↓</span>
        Descend into the network
      </a>
    </div>
  </div>
</section>

<script>
  // Turns scroll position inside the tall spacer into three independent
  // 0..1 weights, one per scene, plus a matching scale for each so a
  // fading scene visibly grows (the camera flying past it) while an
  // arriving scene visibly grows too (the camera arriving at it). Skipped
  // entirely under reduced motion: the CSS fallback shows the Threshold
  // scene statically and nothing here needs to run.
  //
  // The same weights also drive an optional WebGL upgrade (see initWebgl
  // below): the SVG/CSS path always runs first and is always correct on its
  // own: the WebGL layer, when it manages to stand up, just sits visually on
  // top and hides the SVGs, and if it never manages to (no WebGL2, an
  // exception while building the scene, a slow network), nothing here has to
  // know or care — the CSS this loop drives was never turned off.
  // Scroll writes exactly one value — `rawProgress` — and nothing else.
  // Every visual channel (camera pose, scene cross-fade opacity/scale) is
  // instead chased toward that value once per rendered frame via a
  // frame-rate-independent exponential filter (`damp`), so motion keeps
  // flowing for as long as any channel hasn't caught up yet, rather than
  // hard-freezing the instant scrolling stops.
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)");

  function clamp01(n: number) {
    return Math.min(1, Math.max(0, n));
  }

  // A quintic (C2-continuous) ease between two edges: zero velocity AND zero
  // acceleration at edge0/edge1, unlike a cubic smoothstep (C1 — velocity
  // hits zero but acceleration still jumps), which is what read as a kink at
  // every scene-transition boundary and scroll extreme before.
  function quinticStep(edge0: number, edge1: number, x: number) {
    const t = clamp01((x - edge0) / (edge1 - edge0));
    return t * t * t * (t * (t * 6 - 15) + 10);
  }

  function lerp(a: number, b: number, t: number) {
    return a + (b - a) * t;
  }

  // After `halfLife` seconds, `current` has closed half the remaining
  // distance to `target` — true regardless of how choppy the frame times
  // leading up to it were, unlike a fixed per-frame lerp fraction.
  function damp(current: number, target: number, halfLife: number, dt: number) {
    return target + (current - target) * Math.pow(2, -dt / halfLife);
  }

  interface SceneWeights {
    progress: number;
    lookProgress: number;
    surfaceW: number;
    undersoilW: number;
  }

  interface HeroWebglScene {
    setWeights(weights: SceneWeights): void;
  }

  if (!reduceMotion.matches) {
    const wrap = document.querySelector<HTMLElement>(".myco-hero__stage-wrap");
    const stage = document.getElementById("myco-hero-stage");
    const canvas = document.getElementById("myco-hero-canvas") as HTMLCanvasElement | null;
    let webglScene: HeroWebglScene | null = null;

    function rawProgressFromScroll() {
      if (!wrap) return 0;
      const rect = wrap.getBoundingClientRect();
      const scrollable = rect.height - window.innerHeight;
      return scrollable > 0 ? clamp01(-rect.top / scrollable) : 0;
    }

    // One half-life per channel: the look target trails the camera's own
    // position on a visibly slower clock (like a real tracking shot's gaze
    // lagging the dolly), and opacity/scale settle at their own rate rather
    // than snapping through at the position channel's speed.
    const H_PROGRESS = 0.15;
    const H_LOOK = 0.25;
    const H_OPACITY = 0.15;
    const H_SCALE = 0.28;
    const LOOK_LAG_CAP = 0.08;

    // Initialised from the page's actual current scroll position, not 0 —
    // a deep link or back-navigation landing mid-scroll must not produce a
    // false ease-in from the top of the journey.
    let rawProgress = rawProgressFromScroll();
    let smoothedProgress = rawProgress;
    let smoothedLookProgress = rawProgress;
    let surfaceW = 1 - quinticStep(0, 0.3, rawProgress);
    let thresholdW = clamp01(quinticStep(0.12, 0.32, rawProgress) - quinticStep(0.55, 0.75, rawProgress));
    let undersoilW = quinticStep(0.62, 0.88, rawProgress);
    let surfaceS = lerp(1, 1.6, 1 - surfaceW);
    let thresholdS =
      rawProgress < 0.4
        ? lerp(0.7, 1, quinticStep(0.12, 0.32, rawProgress))
        : lerp(1, 1.5, quinticStep(0.55, 0.75, rawProgress));
    let undersoilS = lerp(0.75, 1.05, undersoilW);
    let contentO = 1 - quinticStep(0, 0.22, rawProgress);

    function onScrollOrResize() {
      // The only write in this handler: everything downstream is chased
      // from the per-frame loop below, never from here directly.
      rawProgress = rawProgressFromScroll();
    }

    let rafId = 0;
    let lastT = performance.now();

    function frame(now: number) {
      rafId = requestAnimationFrame(frame);
      const dt = Math.min((now - lastT) / 1000, 0.05); // clamp against tab-switch spikes
      lastT = now;
      if (!stage) return;

      smoothedProgress = damp(smoothedProgress, rawProgress, H_PROGRESS, dt);
      smoothedLookProgress = damp(smoothedLookProgress, smoothedProgress, H_LOOK, dt);
      smoothedLookProgress = clamp01(
        Math.max(smoothedProgress - LOOK_LAG_CAP, Math.min(smoothedProgress + LOOK_LAG_CAP, smoothedLookProgress)),
      );

      const surfaceWTarget = 1 - quinticStep(0, 0.3, smoothedProgress);
      const thresholdWTarget = clamp01(
        quinticStep(0.12, 0.32, smoothedProgress) - quinticStep(0.55, 0.75, smoothedProgress),
      );
      const undersoilWTarget = quinticStep(0.62, 0.88, smoothedProgress);
      const surfaceSTarget = lerp(1, 1.6, 1 - surfaceWTarget);
      const thresholdSTarget =
        smoothedProgress < 0.4
          ? lerp(0.7, 1, quinticStep(0.12, 0.32, smoothedProgress))
          : lerp(1, 1.5, quinticStep(0.55, 0.75, smoothedProgress));
      const undersoilSTarget = lerp(0.75, 1.05, undersoilWTarget);
      const contentOTarget = 1 - quinticStep(0, 0.22, smoothedProgress);

      surfaceW = damp(surfaceW, surfaceWTarget, H_OPACITY, dt);
      thresholdW = damp(thresholdW, thresholdWTarget, H_OPACITY, dt);
      undersoilW = damp(undersoilW, undersoilWTarget, H_OPACITY, dt);
      surfaceS = damp(surfaceS, surfaceSTarget, H_SCALE, dt);
      thresholdS = damp(thresholdS, thresholdSTarget, H_SCALE, dt);
      undersoilS = damp(undersoilS, undersoilSTarget, H_SCALE, dt);
      contentO = damp(contentO, contentOTarget, H_OPACITY, dt);

      stage.style.setProperty("--o-surface", String(surfaceW));
      stage.style.setProperty("--s-surface", String(surfaceS));
      stage.style.setProperty("--o-threshold", String(thresholdW));
      stage.style.setProperty("--s-threshold", String(thresholdS));
      stage.style.setProperty("--o-undersoil", String(undersoilW));
      stage.style.setProperty("--s-undersoil", String(undersoilS));
      stage.style.setProperty("--o-content", String(contentO));

      webglScene?.setWeights({
        progress: quinticStep(0, 1, smoothedProgress),
        lookProgress: quinticStep(0, 1, smoothedLookProgress),
        surfaceW,
        undersoilW,
      });
    }

    function startLoop() {
      lastT = performance.now();
      rafId = requestAnimationFrame(frame);
    }

    function stopLoop() {
      if (rafId) cancelAnimationFrame(rafId);
      rafId = 0;
    }

    window.addEventListener("scroll", onScrollOrResize, { passive: true });
    window.addEventListener("resize", onScrollOrResize);
    startLoop();

    // A live OS toggle mid-session tears the loop down or spins it back up —
    // no reload required to honour a changed motion preference.
    reduceMotion.addEventListener("change", () => {
      if (reduceMotion.matches) stopLoop();
      else startLoop();
    });

    // The WebGL upgrade is opt-in per browser, never a requirement: probe a
    // throwaway canvas for WebGL2 support before touching the real one (and
    // before paying for the `three` chunk at all), and swallow any failure
    // from the scene build itself. Either way the rAF loop above already has
    // this page covered on its own.
    if (canvas && stage) {
      const probe = document.createElement("canvas");
      const gl2Supported = Boolean(probe.getContext("webgl2"));
      if (gl2Supported) {
        initWebgl(canvas, stage)
          .then((scene) => {
            webglScene = scene;
            stage.classList.add("is-webgl");
          })
          .catch(() => {
            // Stay on the SVG/CSS fallback silently — it is a complete
            // experience on its own, not a loading state.
          });
      }
    }
  }

  type ThreeNS = typeof import("three");

  // A small soft-circle sprite, drawn once on a scratch 2D canvas, used as
  // the point-sprite texture for the spore particles below. Nothing here is
  // an imported image asset — it is generated the same way the SVG glow
  // layers are faked, just with a canvas gradient instead of an SVG blur.
  function makeGlowSprite(THREE: ThreeNS) {
    const size = 64;
    const c = document.createElement("canvas");
    c.width = size;
    c.height = size;
    const ctx = c.getContext("2d");
    if (ctx) {
      const g = ctx.createRadialGradient(size / 2, size / 2, 0, size / 2, size / 2, size / 2);
      g.addColorStop(0, "rgba(255,255,255,1)");
      g.addColorStop(0.4, "rgba(255,255,255,0.6)");
      g.addColorStop(1, "rgba(255,255,255,0)");
      ctx.fillStyle = g;
      ctx.fillRect(0, 0, size, size);
    }
    const texture = new THREE.CanvasTexture(c);
    texture.needsUpdate = true;
    return texture;
  }

  // Deterministic pseudo-random-ish jitter, same spirit as the hand-rolled
  // `(i * k) % m` hashes the SVG scenes above use: a build is always the
  // same shape, no `Math.random()` seed to make it drift between builds.
  function hash(i: number, k: number) {
    return ((i * k) % 97) / 97;
  }

  // A second scratch-canvas texture — three horizontal soil bands plus
  // scattered fleck noise — same "fake it with 2D canvas" technique as
  // makeGlowSprite above, used to skin the backdrop soil wall below with
  // something less flat than a solid colour.
  function makeStrataTexture(THREE: ThreeNS) {
    const w = 256,
      h = 512;
    const c = document.createElement("canvas");
    c.width = w;
    c.height = h;
    const ctx = c.getContext("2d");
    if (ctx) {
      const bands: { y0: number; y1: number; color: string }[] = [
        { y0: 0, y1: 0.32, color: "#4d3f30" },
        { y0: 0.32, y1: 0.68, color: "#392e22" },
        { y0: 0.68, y1: 1, color: "#241d15" },
      ];
      for (const band of bands) {
        ctx.fillStyle = band.color;
        ctx.fillRect(0, band.y0 * h, w, (band.y1 - band.y0) * h);
      }
      for (let i = 0; i < 260; i++) {
        const x = hash(i, 53) * w;
        const y = hash(i, 71) * h;
        const r = 1 + hash(i, 13) * 2.4;
        ctx.fillStyle = hash(i, 29) > 0.5 ? "rgba(120,95,60,0.35)" : "rgba(10,8,6,0.4)";
        ctx.beginPath();
        ctx.arc(x, y, r, 0, Math.PI * 2);
        ctx.fill();
      }
    }
    const texture = new THREE.CanvasTexture(c);
    texture.needsUpdate = true;
    return texture;
  }

  // The sRGB counterparts of mycelium.css's `--myco-glow` (teal) and
  // `--myco-glow-2` (violet) OKLCH tokens, converted by hand once — WebGL
  // materials need concrete numbers, not CSS custom properties, so these two
  // have to be kept in visual sync with mycelium.css manually if that
  // palette ever moves.
  const GLOW = 0x00f6c6;
  const GLOW_2 = 0xdf92ff;

  // The same hand-converted-from-OKLCH treatment, this time for mycelium.
  // css's unlit soil/root/rock/water tokens. Every new object below built
  // from these — soil wall, rocks, tuber, detritus, moisture — is
  // deliberately non-emissive (or barely so) and dark enough to sit under
  // the bloom pass's existing 0.2 threshold, so "mushroom and soil" reads
  // as soil rather than as more glow.
  const SOIL_1 = 0x4d3f30;
  const SOIL_2 = 0x392e22;
  const SOIL_3 = 0x241d15;
  const ROOT_COLOR = 0x8a6a4a;
  const ROCK_COLOR = 0x4a4f57;
  const WATER_COLOR = 0x1f3549;

  async function initWebgl(canvas: HTMLCanvasElement, stage: HTMLElement): Promise<HeroWebglScene> {
    const [THREE, { EffectComposer }, { RenderPass }, { UnrealBloomPass }, { OutputPass }, { mergeGeometries }] =
      await Promise.all([
        import("three"),
        import("three/addons/postprocessing/EffectComposer.js"),
        import("three/addons/postprocessing/RenderPass.js"),
        import("three/addons/postprocessing/UnrealBloomPass.js"),
        import("three/addons/postprocessing/OutputPass.js"),
        import("three/addons/utils/BufferGeometryUtils.js"),
      ]);

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.15;
    renderer.outputColorSpace = THREE.SRGBColorSpace;

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x02050a);
    scene.fog = new THREE.FogExp2(0x02050a, 0.05);

    const camera = new THREE.PerspectiveCamera(50, 1, 0.1, 200);

    scene.add(new THREE.AmbientLight(0x223344, 0.5));
    const glowLight = new THREE.PointLight(GLOW, 12, 40, 2);
    glowLight.position.set(0, 4, -14);
    const glow2Light = new THREE.PointLight(GLOW_2, 10, 40, 2);
    glow2Light.position.set(3, 6, -20);
    scene.add(glowLight, glow2Light);

    const ground = new THREE.Mesh(
      new THREE.PlaneGeometry(240, 240),
      new THREE.MeshStandardMaterial({ color: SOIL_2, roughness: 1 }),
    );
    ground.rotation.x = -Math.PI / 2;
    scene.add(ground);

    // A large matte backdrop, well behind every foreground group and past
    // the far end of the camera's own roam range (kfPos below never passes
    // z=-16) — a "wall of dirt" the descent reads against without ever
    // being approached closely enough to risk an occlusion or scale
    // mistake that can't be caught without a browser.
    const soilWall = new THREE.Mesh(
      new THREE.PlaneGeometry(70, 44),
      new THREE.MeshStandardMaterial({ map: makeStrataTexture(THREE), roughness: 1 }),
    );
    soilWall.position.set(0, 18, -34);
    scene.add(soilWall);

    // --- Surface: the forest, scattered around the one mushroom the camera
    // is headed for. Fades out (surfaceW) as the camera commits to the dive.
    const forestGroup = new THREE.Group();
    const forestCapMat = new THREE.MeshStandardMaterial({
      color: GLOW_2,
      emissive: GLOW_2,
      emissiveIntensity: 0.5,
      roughness: 0.5,
      side: THREE.DoubleSide,
      transparent: true,
    });
    const forestStemMat = new THREE.MeshStandardMaterial({ color: SOIL_3, roughness: 0.9, transparent: true });
    for (let i = 0; i < 11; i++) {
      const angle = hash(i, 53) * Math.PI * 2;
      const radius = 4 + hash(i, 31) * 16;
      const x = Math.cos(angle) * radius;
      const z = -4 - hash(i, 17) * 24;
      const s = 0.5 + hash(i, 41) * 1.1;
      const cap = new THREE.Mesh(new THREE.SphereGeometry(1, 12, 8, 0, Math.PI * 2, 0, Math.PI / 2), forestCapMat);
      cap.scale.set(s, s * 0.6, s);
      cap.position.set(x, 1.4 * s, z);
      const stem = new THREE.Mesh(new THREE.CylinderGeometry(0.15 * s, 0.22 * s, 1.4 * s, 8), forestStemMat);
      stem.position.set(x, 0.7 * s, z);
      forestGroup.add(cap, stem);
    }
    scene.add(forestGroup);

    // --- Threshold: the hero mushroom — cap, stem and a radiating starburst
    // of gill blades on its underside — the thing the camera passes under
    // and looks straight up into around the midpoint of the scroll.
    const heroGroup = new THREE.Group();
    heroGroup.position.set(0, 0, -16);
    scene.add(heroGroup);

    const stemMat = new THREE.MeshStandardMaterial({ color: 0x181c24, roughness: 0.85 });
    const heroStem = new THREE.Mesh(new THREE.CylinderGeometry(0.45, 0.6, 3, 16), stemMat);
    heroStem.position.y = 1.5;
    heroGroup.add(heroStem);

    const heroCapMat = new THREE.MeshStandardMaterial({
      color: GLOW_2,
      emissive: GLOW_2,
      emissiveIntensity: 0.4,
      roughness: 0.4,
      side: THREE.DoubleSide,
    });
    const heroCap = new THREE.Mesh(new THREE.SphereGeometry(2.4, 32, 16, 0, Math.PI * 2, 0, Math.PI / 2), heroCapMat);
    heroCap.position.y = 3;
    heroGroup.add(heroCap);

    const GILL_COUNT = 28;
    const gillMat = new THREE.MeshStandardMaterial({
      color: GLOW,
      emissive: GLOW,
      emissiveIntensity: 1.2,
      roughness: 0.3,
      side: THREE.DoubleSide,
    });
    const gillGeo = new THREE.BoxGeometry(0.035, 0.5, 1.7);
    const gillGroup = new THREE.Group();
    gillGroup.position.y = 2.85;
    for (let i = 0; i < GILL_COUNT; i++) {
      const a = (i / GILL_COUNT) * Math.PI * 2;
      const midR = 0.65 + 1.7 / 2;
      const blade = new THREE.Mesh(gillGeo, gillMat);
      blade.position.set(Math.cos(a) * midR, 0, Math.sin(a) * midR);
      blade.rotation.y = Math.PI / 2 - a;
      gillGroup.add(blade);
    }
    heroGroup.add(gillGroup);

    // --- Undersoil: a dense tangle of glowing tubes and drifting spore
    // particles occupying the same space as the gills, faded in
    // (undersoilW) only once the camera has pushed up past them.
    const hyphaeAnchor = new THREE.Vector3(0, 3, -16);
    const hyphaeGroup = new THREE.Group();
    const hyphaeMat = new THREE.MeshStandardMaterial({
      color: GLOW,
      emissive: GLOW,
      emissiveIntensity: 1.6,
      roughness: 0.25,
      transparent: true,
      opacity: 0,
    });
    for (let i = 0; i < 24; i++) {
      const startAngle = hash(i, 71) * Math.PI * 2;
      let x = Math.cos(startAngle) * 2,
        y = hash(i, 19) * 1.6 - 0.6,
        z = Math.sin(startAngle) * 2;
      const points = [new THREE.Vector3(x, y, z)];
      for (let s = 0; s < 4; s++) {
        x += (hash(i + s, 13) - 0.5) * 1.5;
        y += (hash(i + s, 29) - 0.5) * 1.1;
        z += (hash(i + s, 37) - 0.5) * 1.5;
        points.push(new THREE.Vector3(x, y, z));
      }
      const curve = new THREE.CatmullRomCurve3(points);
      const tube = new THREE.Mesh(new THREE.TubeGeometry(curve, 20, 0.03, 5, false), hyphaeMat);
      hyphaeGroup.add(tube);
    }
    hyphaeGroup.position.copy(hyphaeAnchor);
    scene.add(hyphaeGroup);

    const particleCount = 200;
    const positions = new Float32Array(particleCount * 3);
    for (let i = 0; i < particleCount; i++) {
      positions[i * 3 + 0] = hyphaeAnchor.x + (hash(i, 7) - 0.5) * 6;
      positions[i * 3 + 1] = hyphaeAnchor.y + (hash(i, 11) - 0.5) * 4;
      positions[i * 3 + 2] = hyphaeAnchor.z + (hash(i, 23) - 0.5) * 6;
    }
    const particleGeo = new THREE.BufferGeometry();
    particleGeo.setAttribute("position", new THREE.BufferAttribute(positions, 3));
    const particleMat = new THREE.PointsMaterial({
      size: 0.12,
      map: makeGlowSprite(THREE),
      color: GLOW,
      transparent: true,
      opacity: 0,
      depthWrite: false,
      blending: THREE.AdditiveBlending,
    });
    const particles = new THREE.Points(particleGeo, particleMat);
    scene.add(particles);

    // --- Rocks: a scatter of low-poly matte boulders near ground level.
    // Not gated by any weight — unlike the fauna/root-hub content below,
    // scattered stone is a plausible part of the surface floor too, so it
    // stays visible across the whole descent instead of fading in.
    const rockMat = new THREE.MeshStandardMaterial({ color: ROCK_COLOR, roughness: 0.95, flatShading: true });
    const rockGroup = new THREE.Group();
    for (let i = 0; i < 7; i++) {
      const angle = hash(i, 59) * Math.PI * 2;
      const radius = 3 + hash(i, 23) * 5;
      const r = 0.4 + hash(i, 37) * 0.7;
      const rock = new THREE.Mesh(new THREE.IcosahedronGeometry(r, 0), rockMat);
      rock.position.set(Math.cos(angle) * radius, r * 0.4, -12 - hash(i, 43) * 8);
      rock.rotation.set(hash(i, 11) * Math.PI, hash(i, 29) * Math.PI, hash(i, 47) * Math.PI);
      rockGroup.add(rock);
    }
    scene.add(rockGroup);

    // --- Tuber: a central root-hub blob with tapering tendrils, the same
    // hashed-Catmull-Rom tube technique as the hyphae above but thicker,
    // matte and root-coloured rather than glowing — the "genuinely soil"
    // counterweight sharing the hyphae tangle's own neighbourhood.
    const tuberMat = new THREE.MeshStandardMaterial({
      color: ROOT_COLOR,
      roughness: 0.8,
      transparent: true,
      opacity: 0,
    });
    const tuberGroup = new THREE.Group();
    const tuberHub = new THREE.Mesh(new THREE.IcosahedronGeometry(0.5, 1), tuberMat);
    tuberHub.scale.set(1, 0.7, 1);
    tuberGroup.add(tuberHub);
    for (let i = 0; i < 6; i++) {
      const startAngle = hash(i, 67) * Math.PI * 2;
      let x = Math.cos(startAngle) * 0.4,
        y = -0.2,
        z = Math.sin(startAngle) * 0.4;
      const points = [new THREE.Vector3(x, y, z)];
      for (let s = 0; s < 3; s++) {
        x += Math.cos(startAngle) * 0.6 + (hash(i + s, 17) - 0.5) * 0.6;
        y -= 0.4 + hash(i + s, 31) * 0.3;
        z += Math.sin(startAngle) * 0.6 + (hash(i + s, 41) - 0.5) * 0.6;
        points.push(new THREE.Vector3(x, y, z));
      }
      const curve = new THREE.CatmullRomCurve3(points);
      const tube = new THREE.Mesh(new THREE.TubeGeometry(curve, 16, 0.09, 5, false), tuberMat);
      tuberGroup.add(tube);
    }
    tuberGroup.position.copy(hyphaeAnchor).add(new THREE.Vector3(0, -2.6, 0));
    scene.add(tuberGroup);

    // --- Detritus: small capsule fauna-and-crumb stand-ins — literal
    // insect models, hand-built with no way to see the result, were judged
    // too easy to get wrong blind; this is the honest simplification.
    // Merged once into a single BufferGeometry for one draw call.
    const detritusGeometries: InstanceType<typeof THREE.CapsuleGeometry>[] = [];
    for (let i = 0; i < 40; i++) {
      const angle = hash(i, 73) * Math.PI * 2;
      const radius = hash(i, 19) * 3.2;
      const s = 0.05 + hash(i, 53) * 0.09;
      const geo = new THREE.CapsuleGeometry(s, s * 1.6, 2, 4);
      const m = new THREE.Matrix4()
        .makeRotationFromEuler(new THREE.Euler(hash(i, 11) * Math.PI, hash(i, 29) * Math.PI, hash(i, 47) * Math.PI))
        .setPosition(
          hyphaeAnchor.x + Math.cos(angle) * radius,
          hyphaeAnchor.y - 2.5 + hash(i, 61) * 0.6,
          hyphaeAnchor.z + Math.sin(angle) * radius,
        );
      geo.applyMatrix4(m);
      detritusGeometries.push(geo);
    }
    const detritusMat = new THREE.MeshStandardMaterial({
      color: SOIL_1,
      roughness: 1,
      transparent: true,
      opacity: 0,
    });
    const detritusMesh = new THREE.Mesh(mergeGeometries(detritusGeometries), detritusMat);
    scene.add(detritusMesh);

    // --- Moisture: a couple of small dark-water droplets near the tuber
    // hub — flattened spheres, matte enough to stay under the bloom
    // threshold even with a touch of emissive to read as wet rather than
    // as more soil.
    const moistureMat = new THREE.MeshStandardMaterial({
      color: WATER_COLOR,
      emissive: WATER_COLOR,
      emissiveIntensity: 0.15,
      roughness: 0.2,
      transparent: true,
      opacity: 0,
    });
    const moistureGroup = new THREE.Group();
    for (let i = 0; i < 3; i++) {
      const angle = hash(i, 83) * Math.PI * 2;
      const bead = new THREE.Mesh(new THREE.SphereGeometry(0.12 + hash(i, 17) * 0.06, 12, 8), moistureMat);
      bead.scale.y = 0.55;
      bead.position.set(Math.cos(angle) * 1.1, -0.35, Math.sin(angle) * 1.1);
      moistureGroup.add(bead);
    }
    moistureGroup.position.copy(hyphaeAnchor).add(new THREE.Vector3(0, -2.6, 0));
    scene.add(moistureGroup);

    const composer = new EffectComposer(renderer);
    composer.addPass(new RenderPass(scene, camera));
    composer.addPass(new UnrealBloomPass(new THREE.Vector2(1, 1), 0.85, 0.55, 0.2));
    composer.addPass(new OutputPass());

    function resize() {
      const rect = stage.getBoundingClientRect();
      const w = Math.max(1, Math.round(rect.width));
      const h = Math.max(1, Math.round(rect.height));
      renderer.setSize(w, h, false);
      composer.setSize(w, h);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    }
    resize();
    window.addEventListener("resize", resize);

    let isVisible = true;
    const io = new IntersectionObserver(
      (entries) => {
        isVisible = entries.some((entry) => entry.isIntersecting);
      },
      { threshold: 0 },
    );
    io.observe(stage);

    // Four hand-placed camera keyframes: wide forest shot, closing in on the
    // hero cap, directly beneath it looking up into the gills, then pushed
    // up past them into the hyphae tangle — one continuous dolly rather than
    // the cross-fading flat layers the SVG version has to use instead.
    //
    // These used to be walked with two straight-line lerps (segment [0,1],
    // segment [1,2], segment [2,3]), each individually eased — which put a
    // visible kink in the camera's velocity *and* direction at every
    // keyframe, because two different straight lines meeting at a point
    // have no reason to share a tangent. A single Catmull-Rom spline through
    // all four points removes that: the path itself is smooth at the
    // keyframes, not just the timing of travel along it.
    //
    // Catmull-Rom needs a point before the first and after the last to
    // define the tangent AT the first/last keyframe (an open curve otherwise
    // has to guess). `padEndpoints` adds one phantom point on each end via
    // linear extrapolation of the boundary segment, purely so those two real
    // endpoints get a well-defined tangent — `paramToArcFraction` below then
    // finds exactly where the real (non-phantom) span sits in arc length, so
    // progress 0 and 1 still land precisely on kfPos[0] and kfPos[last].
    const kfPos = [new THREE.Vector3(0, 5, 14), new THREE.Vector3(2, 3.2, -10), new THREE.Vector3(0, 1.6, -16), new THREE.Vector3(0, 3.4, -16)];
    const kfLook = [new THREE.Vector3(0, 3, -10), new THREE.Vector3(0, 3, -16), new THREE.Vector3(0, 3, -16), new THREE.Vector3(0, 4.4, -16)];

    function padEndpoints(pts: InstanceType<typeof THREE.Vector3>[]) {
      const start = pts[0]!.clone().multiplyScalar(2).sub(pts[1]!);
      const end = pts[pts.length - 1]!.clone().multiplyScalar(2).sub(pts[pts.length - 2]!);
      return [start, ...pts, end];
    }

    // Arc-length fraction (0..1 over the WHOLE padded curve, phantom
    // segments included) at parameter `t` — read off the curve's own cached
    // length table. This is what lets `posU0`/`posU1` below pin exactly
    // where the real first/last keyframe sit once the phantom segments'
    // share of the total length is excluded from the 0..1 travel range.
    function paramToArcFraction(curve: InstanceType<typeof THREE.CatmullRomCurve3>, t: number, divisions = 200) {
      const lengths = curve.getLengths(divisions);
      const total = lengths[lengths.length - 1]!;
      const idx = clamp01(t) * divisions;
      const i0 = Math.floor(idx);
      const i1 = Math.min(divisions, i0 + 1);
      const frac = idx - i0;
      const len = lengths[i0]! + (lengths[i1]! - lengths[i0]!) * frac;
      return total > 0 ? len / total : 0;
    }

    const posCurve = new THREE.CatmullRomCurve3(padEndpoints(kfPos), false, "centripetal");
    const lookCurve = new THREE.CatmullRomCurve3(padEndpoints(kfLook), false, "centripetal");
    // Warm both arc-length tables once, off the per-frame path.
    posCurve.getLengths(200);
    lookCurve.getLengths(200);
    const posT0 = 1 / (kfPos.length + 1);
    const posT1 = kfPos.length / (kfPos.length + 1);
    const posU0 = paramToArcFraction(posCurve, posT0);
    const posU1 = paramToArcFraction(posCurve, posT1);
    const lookT0 = 1 / (kfLook.length + 1);
    const lookT1 = kfLook.length / (kfLook.length + 1);
    const lookU0 = paramToArcFraction(lookCurve, lookT0);
    const lookU1 = paramToArcFraction(lookCurve, lookT1);

    function setWeights({ progress, lookProgress, surfaceW, undersoilW }: SceneWeights) {
      // getPointAt (not getPoint) samples by arc length, not by raw
      // parameter — required here since the four real keyframes are
      // nowhere near evenly spaced (a short hop into the cap, then a long
      // push into the hyphae), so equal parameter steps would otherwise
      // speed through the short leg and crawl the long one.
      camera.position.copy(posCurve.getPointAt(lerp(posU0, posU1, clamp01(progress))));
      camera.lookAt(lookCurve.getPointAt(lerp(lookU0, lookU1, clamp01(lookProgress))));

      forestGroup.visible = surfaceW > 0.01;
      forestCapMat.opacity = surfaceW;
      forestStemMat.opacity = surfaceW;

      hyphaeGroup.visible = undersoilW > 0.01;
      hyphaeMat.opacity = undersoilW;
      particleMat.opacity = undersoilW * 0.8;

      tuberGroup.visible = undersoilW > 0.01;
      tuberMat.opacity = undersoilW;

      detritusMesh.visible = undersoilW > 0.01;
      detritusMat.opacity = undersoilW;

      moistureGroup.visible = undersoilW > 0.01;
      moistureMat.opacity = undersoilW;
    }
    setWeights({ progress: 0, lookProgress: 0, surfaceW: 1, undersoilW: 0 });

    function render() {
      requestAnimationFrame(render);
      if (!isVisible) return;
      particles.rotation.y = performance.now() * 0.00008;
      composer.render();
    }
    render();

    return { setWeights };
  }
</script>

