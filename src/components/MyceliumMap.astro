---
// The homepage's own design, not a reskin of the template: the twelve weeks
// rendered as fruiting bodies strung along a single mycelial trunk, the trunk
// itself grown from a small deterministic curve (not twelve hand-placed
// coordinates) so it reads as one continuous organism rather than a chart.
// Signal drifts down it the same way the course argues carbon and warning
// signals actually move through a real network: continuously, along fixed
// channels, not on demand.
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";
import WeekGlyph from "./WeekGlyph.astro";

interface MapNode {
  week: number;
  slug: string;
  title: string;
  metaphor: string;
}

const sessions = await getPublishedCollection("sessions");
const nodes: MapNode[] = sessions
  .map((session) => ({
    week: session.data.week,
    slug: session.id,
    title: session.data.title,
    metaphor: String(session.data.metaphor ?? ""),
  }))
  .sort((a, b) => a.week - b.week);

const WIDTH = 800;
const NODE_GAP = 132;
const PAD_TOP = 90;
const PAD_BOTTOM = 100;
const HEIGHT = PAD_TOP + PAD_BOTTOM + NODE_GAP * Math.max(nodes.length - 1, 1);

// A fixed, seeded wobble — same build, same shape, every time. Two sine
// harmonics beat against each other so the trunk reads as grown, not plotted.
function coord(i: number) {
  const y = PAD_TOP + NODE_GAP * i;
  // Amplitude is kept small enough that the clamp below almost never fires —
  // the safety margin exists for card overflow on narrow viewports, not to
  // reshape the curve into flat-sided clipping.
  const wobble = Math.sin(i * 1.15 + 0.4) * 168 + Math.sin(i * 2.7 + 1.8) * 34;
  const x = Math.min(WIDTH * 0.82, Math.max(WIDTH * 0.18, WIDTH / 2 + wobble));
  return { x, y };
}

const points = nodes.map((_, i) => coord(i));

// Catmull-Rom through the node points, converted to cubic Bezier segments,
// so the trunk curves smoothly through every node instead of kinking at it.
function smoothPath(pts: { x: number; y: number }[]): string {
  if (pts.length === 0) return "";
  if (pts.length === 1) return `M ${pts[0].x} ${pts[0].y}`;
  let d = `M ${pts[0].x} ${pts[0].y}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[i - 1] ?? pts[i];
    const p1 = pts[i];
    const p2 = pts[i + 1];
    const p3 = pts[i + 2] ?? p2;
    const c1x = p1.x + (p2.x - p0.x) / 6;
    const c1y = p1.y + (p2.y - p0.y) / 6;
    const c2x = p2.x - (p3.x - p1.x) / 6;
    const c2y = p2.y - (p3.y - p1.y) / 6;
    d += ` C ${c1x} ${c1y} ${c2x} ${c2y} ${p2.x} ${p2.y}`;
  }
  return d;
}

const trunkPath = smoothPath(points);

// Decorative-only offshoots between consecutive nodes: nothing they touch is
// load-bearing information, so they carry no labels and no links.
const branches = points.slice(0, -1).map((p, i) => {
  const q = points[i + 1];
  const mx = (p.x + q.x) / 2;
  const my = (p.y + q.y) / 2;
  const side = i % 2 === 0 ? 1 : -1;
  const reach = 60 + ((i * 37) % 46);
  const tipX = mx + side * reach;
  const tipY = my - 16 + ((i * 19) % 22);
  const cx = mx + side * reach * 0.55;
  const cy = my - 8;
  return { d: `M ${mx} ${my} Q ${cx} ${cy} ${tipX} ${tipY}`, tipX, tipY };
});

const pulseCount = Math.min(nodes.length, 6);
---

<div class="mycelium-map" style={`--map-height: ${HEIGHT}px`}>
  <svg
    class="mycelium-map__art"
    viewBox={`0 0 ${WIDTH} ${HEIGHT}`}
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
  >
    {
      branches.map((branch) => (
        <>
          <path d={branch.d} class="mm-branch" />
          <circle cx={branch.tipX} cy={branch.tipY} r="3.4" class="mm-spore" />
        </>
      ))
    }
    <path id="mm-trunk" d={trunkPath} class="mm-trunk" />
    {
      Array.from({ length: pulseCount }).map((_, i) => (
        <circle r="4.5" class="mm-pulse">
          <animateMotion
            dur={`${11 + (i % 4) * 2.5}s`}
            begin={`${i * -2.1}s`}
            repeatCount="indefinite"
            keyPoints="0;1"
            keyTimes="0;1"
            calcMode="linear"
          >
            <mpath href="#mm-trunk" />
          </animateMotion>
        </circle>
      ))
    }
  </svg>

  <ol class="mycelium-map__nodes">
    {
      nodes.map((node, i) => (
        <li
          class="mm-node"
          style={`--nx: ${(points[i].x / WIDTH) * 100}%; --ny: ${(points[i].y / HEIGHT) * 100}%; --ni: ${i}`}
        >
          <a href={withBase(`/sessions/${node.slug}/`)}>
            <WeekGlyph week={node.week} class="mm-node__glyph" />
            <span class="mm-node__text">
              <span class="mm-node__week">Week {node.week}</span>
              <span class="mm-node__title">{node.title}</span>
              <span class="mm-node__caption">{node.metaphor}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</div>

<script>
  // The trunk's own pulses are decorative motion, not information: anyone
  // who has asked the OS to reduce motion gets a still network, not a
  // slowed one. SMIL animations aren't reachable from CSS, so this is the
  // one place the map needs a script rather than a stylesheet.
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)");
  function applyMotionPreference() {
    document.querySelectorAll<SVGAnimateMotionElement>(".mycelium-map animateMotion").forEach((anim) => {
      anim.setAttribute("dur", reduceMotion.matches ? "0.1s" : anim.dataset.dur ?? "12s");
    });
  }
  document.querySelectorAll<SVGAnimateMotionElement>(".mycelium-map animateMotion").forEach((anim) => {
    anim.dataset.dur = anim.getAttribute("dur") ?? "12s";
  });
  applyMotionPreference();
  reduceMotion.addEventListener("change", applyMotionPreference);
</script>

<style>
  .mycelium-map {
    position: relative;
    width: 100%;
    height: var(--map-height);
    margin-block-end: var(--at-spacing-2xl);
  }

  .mycelium-map__art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* A node near the 18–82% band can still, on a very narrow viewport, ask
     for more card width than the space to the edge — clip rather than let
     it force page-wide horizontal scroll. The clamp above keeps this rare
     and shallow, not the primary defence. */
  .mycelium-map {
    overflow-x: clip;
  }

  .mm-trunk {
    fill: none;
    stroke: var(--at-primary);
    stroke-width: 3;
    stroke-linecap: round;
    opacity: 0.55;
    filter: drop-shadow(0 0 5px var(--myco-glow-soft));
    animation: mm-trunk-breathe 7s ease-in-out infinite;
  }

  .mm-branch {
    fill: none;
    stroke: var(--at-primary);
    stroke-width: 1.6;
    stroke-linecap: round;
    opacity: 0.28;
    filter: drop-shadow(0 0 3px var(--myco-glow-soft));
  }

  .mm-spore {
    fill: var(--at-secondary);
    opacity: 0.4;
    filter: drop-shadow(0 0 4px var(--myco-glow-2));
  }

  .mm-pulse {
    fill: var(--at-secondary);
    filter: drop-shadow(0 0 6px var(--myco-glow)) drop-shadow(0 0 12px var(--myco-glow-soft));
  }

  @keyframes mm-trunk-breathe {
    0%, 100% { filter: drop-shadow(0 0 5px var(--myco-glow-soft)); }
    50% { filter: drop-shadow(0 0 11px var(--myco-glow)); }
  }

  .mycelium-map__nodes {
    position: relative;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mm-node {
    position: absolute;
    left: var(--nx);
    top: var(--ny);
    transform: translate(-50%, -50%);
  }

  .mm-node a {
    display: flex;
    align-items: center;
    gap: var(--at-spacing-sm);
    padding: var(--at-spacing-xs) var(--at-spacing-sm) var(--at-spacing-xs) var(--at-spacing-xs);
    border-radius: 999px;
    background: var(--at-bg-elevated);
    border: 2px solid var(--at-border);
    box-shadow: var(--at-shadow-sm);
    color: var(--at-text);
    text-decoration: none;
    max-width: min(58vw, 18rem);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }

  .mm-node a:hover,
  .mm-node a:focus-visible {
    transform: scale(1.05);
    border-color: var(--at-primary);
    box-shadow: var(--at-shadow-lg);
  }

  .mm-node__glyph {
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    color: var(--at-on-primary);
    border-radius: 999px;
    background: var(--at-primary);
    padding: 0.3rem;
    box-sizing: border-box;
  }

  .mm-node__text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    line-height: 1.2;
    overflow: hidden;
  }

  .mm-node__week {
    font-family: var(--at-font-mono);
    font-size: var(--at-font-size-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--at-text-secondary);
  }

  .mm-node__title {
    font-weight: 700;
    font-size: var(--at-font-size-sm);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mm-node__caption {
    font-size: var(--at-font-size-xs);
    color: var(--at-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mm-node a:hover .mm-node__caption,
  .mm-node a:focus-visible .mm-node__caption {
    color: var(--at-text);
  }

  @media (prefers-reduced-motion: reduce) {
    .mm-node a {
      transition: none;
    }

    .mm-trunk {
      animation: none;
    }
  }

  @media (max-width: 40rem) {
    .mm-node a {
      max-width: 46vw;
    }

    .mm-node__caption {
      display: none;
    }
  }
</style>
