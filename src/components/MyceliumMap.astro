---
// Twelve weeks as one organism: a trunk grown from a deterministic curve,
// hyphae branching off it, fruiting bodies at each week. Not a chart and
// not a card list. Signal still moves down the trunk the way the course
// says carbon actually moves — continuously, along fixed channels.
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";
import WeekGlyph from "./WeekGlyph.astro";

interface MapNode {
  week: number;
  slug: string;
  title: string;
  metaphor: string;
}

const sessions = await getPublishedCollection("sessions");
const nodes: MapNode[] = sessions
  .map((session) => ({
    week: session.data.week,
    slug: session.id,
    title: session.data.title,
    metaphor: String(session.data.metaphor ?? ""),
  }))
  .sort((a, b) => a.week - b.week);

const WIDTH = 1200;
const NODE_GAP = 200;
const PAD_TOP = 160;
const PAD_BOTTOM = 180;
const HEIGHT = PAD_TOP + PAD_BOTTOM + NODE_GAP * Math.max(nodes.length - 1, 1);

function coord(i: number) {
  const y = PAD_TOP + NODE_GAP * i;
  const wobble = Math.sin(i * 1.08 + 0.35) * 150 + Math.sin(i * 2.4 + 1.6) * 32;
  const x = Math.min(WIDTH * 0.68, Math.max(WIDTH * 0.32, WIDTH / 2 + wobble));
  return { x, y };
}

const points = nodes.map((_, i) => coord(i));

function smoothPath(pts: { x: number; y: number }[]): string {
  if (pts.length === 0) return "";
  if (pts.length === 1) return `M ${pts[0].x} ${pts[0].y}`;
  let d = `M ${pts[0].x} ${pts[0].y}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[i - 1] ?? pts[i];
    const p1 = pts[i];
    const p2 = pts[i + 1];
    const p3 = pts[i + 2] ?? p2;
    const c1x = p1.x + (p2.x - p0.x) / 6;
    const c1y = p1.y + (p2.y - p0.y) / 6;
    const c2x = p2.x - (p3.x - p1.x) / 6;
    const c2y = p2.y - (p3.y - p1.y) / 6;
    d += ` C ${c1x} ${c1y} ${c2x} ${c2y} ${p2.x} ${p2.y}`;
  }
  return d;
}

const trunkPath = smoothPath(points);

const TENDRILS_PER_GAP = [4, 5, 4, 6];
const branches = points.slice(0, -1).flatMap((p, i) => {
  const q = points[i + 1];
  const count = TENDRILS_PER_GAP[i % TENDRILS_PER_GAP.length];
  return Array.from({ length: count }, (_, j) => {
    const t = (j + 1) / (count + 1);
    const bx = p.x + (q.x - p.x) * t;
    const by = p.y + (q.y - p.y) * t;
    const side = (i + j) % 2 === 0 ? 1 : -1;
    const reach = 70 + ((i * 37 + j * 29) % 90);
    const tipX = bx + side * reach;
    const tipY = by - 18 + ((i * 19 + j * 13) % 36);
    const cx = bx + side * reach * 0.55;
    const cy = by - 12;
    const fork = (i + j) % 3 === 0;
    const forkX = tipX + side * (28 + ((i * 11 + j) % 22));
    const forkY = tipY + 10 + ((j * 7) % 16);
    return {
      d: `M ${bx} ${by} Q ${cx} ${cy} ${tipX} ${tipY}`,
      forkD: fork ? `M ${tipX} ${tipY} Q ${tipX + side * 14} ${tipY + 8} ${forkX} ${forkY}` : "",
      tipX,
      tipY,
      forkX,
      forkY,
      fork,
    };
  });
});

const anastomoses = branches
  .filter((_, i) => i % 6 === 2)
  .map((b, i) => {
    const other = branches[(i * 5 + 7) % branches.length];
    const mx = (b.tipX + other.tipX) / 2;
    const my = (b.tipY + other.tipY) / 2 - 16;
    return `M ${b.tipX} ${b.tipY} Q ${mx} ${my} ${other.tipX} ${other.tipY}`;
  });

const pulseCount = Math.min(nodes.length, 7);

const detritusSpecks = Array.from({ length: 22 }, (_, i) => {
  const p = points[i % points.length];
  const ox = ((i * 47) % 180) - 90;
  const oy = ((i * 31) % 70) - 20;
  return { x: p.x + ox, y: p.y + oy, r: 1 + ((i * 13) % 3) };
});

const ants = [0.28, 0.55, 0.82].map((f, i) => {
  const p = points[Math.min(points.length - 1, Math.floor((points.length - 1) * f))];
  const flip = i % 2 === 1;
  return { x: p.x + (flip ? 62 : -68), y: p.y + (flip ? -22 : 36), flip };
});
---

<div id="mycelium-map" class="mycelium-map" style={`--map-height: ${HEIGHT}px`}>
  <svg
    class="mycelium-map__art"
    viewBox={`0 0 ${WIDTH} ${HEIGHT}`}
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
  >
    <path d={trunkPath} class="mm-trunk-field" />
    {
      branches.map((branch) => (
        <>
          <path d={branch.d} class="mm-branch" />
          {branch.forkD && <path d={branch.forkD} class="mm-branch mm-branch--fork" />}
          <circle cx={branch.tipX} cy={branch.tipY} r="2.8" class="mm-spore" />
          {branch.fork && <circle cx={branch.forkX} cy={branch.forkY} r="2.1" class="mm-spore" />}
        </>
      ))
    }
    {
      anastomoses.map((d) => (
        <path d={d} class="mm-branch mm-branch--join" />
      ))
    }
    <path id="mm-trunk" d={trunkPath} class="mm-trunk" />
    {
      Array.from({ length: pulseCount }).map((_, i) => (
        <circle r="5" class="mm-pulse">
          <animateMotion
            dur={`${12 + (i % 4) * 2.4}s`}
            begin={`${i * -2.2}s`}
            repeatCount="indefinite"
            keyPoints="0;1"
            keyTimes="0;1"
            calcMode="linear"
          >
            <mpath href="#mm-trunk" />
          </animateMotion>
        </circle>
      ))
    }
    {
      detritusSpecks.map((s) => (
        <use href="#myco-fauna-fleck" x={s.x - s.r} y={s.y - s.r} width={s.r * 2} height={s.r * 2} class="mm-detritus" />
      ))
    }
    {
      ants.map((a) => (
        <g transform={`translate(${a.x} ${a.y}) scale(${a.flip ? -1 : 1}, 1)`}>
          <use href="#myco-fauna-ant" x="-10" y="-5" width="20" height="10" class="mm-ant" />
        </g>
      ))
    }
  </svg>

  <ol class="mycelium-map__nodes">
    {
      nodes.map((node, i) => {
        const side = points[i].x > WIDTH / 2 ? "left" : "right";
        return (
          <li
            class:list={["mm-node", `mm-node--${side}`, i === nodes.length - 1 && "mm-node--summit", "mm-node--visible"]}
            style={`--nx: ${(points[i].x / WIDTH) * 100}%; --ny: ${(points[i].y / HEIGHT) * 100}%; --ni: ${i}`}
          >
            <a href={withBase(`/sessions/${node.slug}/`)}>
              <span class="mm-node__no" aria-hidden="true">{String(node.week).padStart(2, "0")}</span>
              <WeekGlyph week={node.week} class="mm-node__glyph" />
              <span class="mm-node__text">
                <span class="mm-node__week">Week {node.week}</span>
                <span class="mm-node__title">{node.title}</span>
                {node.metaphor && <span class="mm-node__caption">{node.metaphor}</span>}
              </span>
            </a>
          </li>
        );
      })
    }
  </ol>
</div>

<script>
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)");
  const map = document.querySelector<HTMLElement>(".mycelium-map");
  const trunk = document.querySelector<SVGPathElement>("#mm-trunk");

  document.querySelectorAll<SVGAnimateMotionElement>(".mycelium-map animateMotion").forEach((anim) => {
    anim.dataset.dur = anim.getAttribute("dur") ?? "12s";
    if (reduceMotion.matches) anim.setAttribute("dur", "0.1s");
  });

  if (reduceMotion.matches) {
    map?.style.setProperty("--hypha-draw", "1");
  } else {
    if (map && trunk) {
      const length = trunk.getTotalLength();
      trunk.style.strokeDasharray = String(length);

      function draw() {
        if (!map || !trunk) return;
        const rect = map.getBoundingClientRect();
        const start = window.innerHeight * 0.78;
        const span = rect.height + window.innerHeight * 0.2;
        const progress = Math.min(1, Math.max(0, (start - rect.top) / span));
        map.style.setProperty("--hypha-draw", String(progress));
        trunk.style.strokeDashoffset = String(length * (1 - progress));
      }

      draw();
      window.addEventListener("scroll", draw, { passive: true });
      window.addEventListener("resize", draw);
    }
  }
</script>

<style>
  .mycelium-map {
    position: relative;
    width: 100%;
    min-height: var(--map-height);
    height: var(--map-height);
    overflow: visible;
    scroll-margin-top: 5rem;
  }

  .mycelium-map__art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .mm-trunk-field {
    fill: none;
    stroke: var(--myco-glow-2);
    stroke-width: 64;
    stroke-linecap: round;
    opacity: 0.09;
    filter: blur(26px);
  }

  .mm-trunk {
    fill: none;
    stroke: var(--at-primary);
    stroke-width: 4.2;
    stroke-linecap: round;
    opacity: 0.72;
    filter: drop-shadow(0 0 7px var(--myco-glow-soft));
    animation: mm-trunk-breathe 7s ease-in-out infinite;
  }

  .mm-branch {
    fill: none;
    stroke: var(--at-primary);
    stroke-width: 1.35;
    stroke-linecap: round;
    opacity: calc(0.12 + var(--hypha-draw, 0) * 0.32);
    filter: drop-shadow(0 0 3px var(--myco-glow-soft));
  }

  .mm-branch--fork,
  .mm-branch--join {
    stroke-width: 0.9;
    opacity: calc(0.06 + var(--hypha-draw, 0) * 0.22);
  }

  .mm-spore {
    fill: var(--at-secondary);
    opacity: calc(0.15 + var(--hypha-draw, 0) * 0.4);
    filter: drop-shadow(0 0 4px var(--myco-glow-2));
  }

  .mm-pulse {
    fill: var(--at-secondary);
    filter: drop-shadow(0 0 6px var(--myco-glow)) drop-shadow(0 0 12px var(--myco-glow-soft));
  }

  @keyframes mm-trunk-breathe {
    0%,
    100% {
      filter: drop-shadow(0 0 5px var(--myco-glow-soft));
    }
    50% {
      filter: drop-shadow(0 0 12px var(--myco-glow));
    }
  }

  .mycelium-map__nodes {
    position: relative;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mm-node {
    position: absolute;
    top: var(--ny);
    z-index: 1;
    color: var(--at-text);
    opacity: 1;
  }

  .mm-node--right {
    left: var(--nx);
    transform: translateY(-50%);
    padding-left: 1.15rem;
  }

  .mm-node--left {
    right: calc(100% - var(--nx));
    left: auto;
    transform: translateY(-50%);
    text-align: right;
    padding-right: 1.15rem;
  }

  .mm-node a {
    display: grid;
    grid-template-columns: auto auto minmax(12rem, 1fr);
    align-items: center;
    gap: 0.65rem 0.85rem;
    max-width: min(42vw, 24rem);
    color: inherit;
    text-decoration: none;
  }

  .mm-node--left a {
    grid-template-columns: minmax(12rem, 1fr) auto auto;
  }

  .mm-node--left .mm-node__no {
    order: 3;
  }

  .mm-node--left .mm-node__glyph {
    order: 2;
  }

  .mm-node--left .mm-node__text {
    order: 1;
  }

  .mm-node__no {
    font-family: var(--myco-font-display, ui-serif, Georgia, serif);
    font-size: clamp(2.4rem, 5vw, 4.2rem);
    font-weight: 400;
    line-height: 0.75;
    letter-spacing: -0.07em;
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in oklch, var(--at-text) 48%, transparent);
  }

  .mm-node__glyph {
    flex: none;
    width: 1.7rem;
    height: 1.7rem;
    color: var(--at-primary);
  }

  .mm-node__text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 12rem;
    overflow: visible;
  }

  .mm-node__week {
    font-family: var(--at-font-mono);
    font-size: var(--at-font-size-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--at-text-secondary);
  }

  .mm-node__title {
    font-family: var(--myco-font-display, ui-serif, Georgia, serif);
    font-size: clamp(1.35rem, 2.6vw, 2.1rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.025em;
    color: var(--at-text);
  }

  .mm-node__caption {
    font-size: var(--at-font-size-sm);
    color: var(--at-text-secondary);
    max-width: 22rem;
  }

  .mm-node a:hover .mm-node__title,
  .mm-node a:focus-visible .mm-node__title {
    color: var(--at-primary);
  }

  .mm-node--summit .mm-node__no {
    font-size: clamp(4.2rem, 9vw, 8rem);
    -webkit-text-stroke-color: color-mix(in oklch, var(--at-primary) 55%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .mm-trunk {
      animation: none;
    }
  }

  @media (max-width: 50rem) {
    .mm-node--left,
    .mm-node--right {
      left: 1.1rem;
      right: 1.1rem;
      width: auto;
      text-align: left;
      padding-left: 0;
      padding-right: 0;
    }

    .mm-node a,
    .mm-node--left a {
      grid-template-columns: auto minmax(0, 1fr);
      max-width: none;
      width: 100%;
    }

    .mm-node--left .mm-node__no,
    .mm-node--right .mm-node__no {
      display: none;
    }

    .mm-node--left .mm-node__glyph,
    .mm-node--left .mm-node__text {
      order: initial;
    }

    .mm-node__text {
      min-width: 0;
    }

    .mm-node__caption {
      display: none;
    }
  }
</style>
