---
// The homepage's own design, not a reskin of the template: the twelve weeks
// rendered as fruiting bodies strung along a single mycelial trunk, the trunk
// itself grown from a small deterministic curve (not twelve hand-placed
// coordinates) so it reads as one continuous organism rather than a chart.
// Signal drifts down it the same way the course argues carbon and warning
// signals actually move through a real network: continuously, along fixed
// channels, not on demand.
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";
import WeekGlyph from "./WeekGlyph.astro";

interface MapNode {
  week: number;
  slug: string;
  title: string;
  metaphor: string;
}

const sessions = await getPublishedCollection("sessions");
const nodes: MapNode[] = sessions
  .map((session) => ({
    week: session.data.week,
    slug: session.id,
    title: session.data.title,
    metaphor: String(session.data.metaphor ?? ""),
  }))
  .sort((a, b) => a.week - b.week);

const WIDTH = 800;
const NODE_GAP = 132;
const PAD_TOP = 90;
const PAD_BOTTOM = 100;
const HEIGHT = PAD_TOP + PAD_BOTTOM + NODE_GAP * Math.max(nodes.length - 1, 1);

// A fixed, seeded wobble — same build, same shape, every time. Two sine
// harmonics beat against each other so the trunk reads as grown, not plotted.
function coord(i: number) {
  const y = PAD_TOP + NODE_GAP * i;
  // Amplitude is kept small enough that the clamp below almost never fires —
  // the safety margin exists for card overflow on narrow viewports, not to
  // reshape the curve into flat-sided clipping.
  const wobble = Math.sin(i * 1.15 + 0.4) * 168 + Math.sin(i * 2.7 + 1.8) * 34;
  const x = Math.min(WIDTH * 0.82, Math.max(WIDTH * 0.18, WIDTH / 2 + wobble));
  return { x, y };
}

const points = nodes.map((_, i) => coord(i));

// Catmull-Rom through the node points, converted to cubic Bezier segments,
// so the trunk curves smoothly through every node instead of kinking at it.
function smoothPath(pts: { x: number; y: number }[]): string {
  if (pts.length === 0) return "";
  if (pts.length === 1) return `M ${pts[0].x} ${pts[0].y}`;
  let d = `M ${pts[0].x} ${pts[0].y}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[i - 1] ?? pts[i];
    const p1 = pts[i];
    const p2 = pts[i + 1];
    const p3 = pts[i + 2] ?? p2;
    const c1x = p1.x + (p2.x - p0.x) / 6;
    const c1y = p1.y + (p2.y - p0.y) / 6;
    const c2x = p2.x - (p3.x - p1.x) / 6;
    const c2y = p2.y - (p3.y - p1.y) / 6;
    d += ` C ${c1x} ${c1y} ${c2x} ${c2y} ${p2.x} ${p2.y}`;
  }
  return d;
}

const trunkPath = smoothPath(points);

// Decorative-only offshoots between consecutive nodes: nothing they touch is
// load-bearing information, so they carry no labels and no links. Two or
// three tendrils per gap (not one) so the trunk reads as a dense, fruiting
// network rather than a single line with the occasional twig.
const TENDRILS_PER_GAP = [2, 3];
const branches = points.slice(0, -1).flatMap((p, i) => {
  const q = points[i + 1];
  const count = TENDRILS_PER_GAP[i % TENDRILS_PER_GAP.length];
  return Array.from({ length: count }, (_, j) => {
    const t = (j + 1) / (count + 1);
    const bx = p.x + (q.x - p.x) * t;
    const by = p.y + (q.y - p.y) * t;
    const side = (i + j) % 2 === 0 ? 1 : -1;
    const reach = 46 + ((i * 37 + j * 29) % 52);
    const tipX = bx + side * reach;
    const tipY = by - 14 + ((i * 19 + j * 13) % 24);
    const cx = bx + side * reach * 0.55;
    const cy = by - 8;
    return { d: `M ${bx} ${by} Q ${cx} ${cy} ${tipX} ${tipY}`, tipX, tipY };
  });
});

const pulseCount = Math.min(nodes.length, 6);

// Set dressing, not subject matter: real soil isn't only glowing fungal
// thread — it's also inert crumbs of humus and the odd insect. Both are
// dim, unlit and carry no glow filter at all, on purpose, so they read as
// background matter the network grows through rather than another light
// source competing with the trunk and pulses.
const detritusSpecks = Array.from({ length: 14 }, (_, i) => {
  const p = points[i % points.length];
  const ox = ((i * 47) % 140) - 70;
  const oy = (((i * 31) % 60) - 30) + 44;
  return { x: p.x + ox, y: p.y + oy, r: 1 + ((i * 13) % 3) };
});

const ants = [0.32, 0.68].map((f, i) => {
  const p = points[Math.min(points.length - 1, Math.floor((points.length - 1) * f))];
  const flip = i === 1;
  return { x: p.x + (flip ? 54 : -60), y: p.y + (flip ? -18 : 32), flip };
});
---

<div id="mycelium-map" class="mycelium-map" style={`--map-height: ${HEIGHT}px`}>
  <svg
    class="mycelium-map__art"
    viewBox={`0 0 ${WIDTH} ${HEIGHT}`}
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
  >
    {/* A soft, blurred echo of the trunk's own path, much wider and almost
        transparent — a diffuse root mass giving the crisp trunk above it
        somewhere to sit, rather than floating on bare background. */}
    <path d={trunkPath} class="mm-trunk-field" />
    {
      branches.map((branch) => (
        <>
          <path d={branch.d} class="mm-branch" />
          <circle cx={branch.tipX} cy={branch.tipY} r="3.4" class="mm-spore" />
        </>
      ))
    }
    <path id="mm-trunk" d={trunkPath} class="mm-trunk" />
    {
      Array.from({ length: pulseCount }).map((_, i) => (
        <circle r="4.5" class="mm-pulse">
          <animateMotion
            dur={`${11 + (i % 4) * 2.5}s`}
            begin={`${i * -2.1}s`}
            repeatCount="indefinite"
            keyPoints="0;1"
            keyTimes="0;1"
            calcMode="linear"
          >
            <mpath href="#mm-trunk" />
          </animateMotion>
        </circle>
      ))
    }
    {
      /* Fauna/detritus geometry lives once in FaunaSymbols.astro (mounted by
         index.astro) and is only referenced here via <use> — see mycelium.css
         for the shared .mm-detritus/.mm-ant styling. */
      detritusSpecks.map((s) => (
        <use href="#myco-fauna-fleck" x={s.x - s.r} y={s.y - s.r} width={s.r * 2} height={s.r * 2} class="mm-detritus" />
      ))
    }
    {
      ants.map((a) => (
        <g transform={`translate(${a.x} ${a.y}) scale(${a.flip ? -1 : 1}, 1)`}>
          <use href="#myco-fauna-ant" x="-10" y="-5" width="20" height="10" class="mm-ant" />
        </g>
      ))
    }
  </svg>

  <ol class="mycelium-map__nodes">
    {
      nodes.map((node, i) => (
        <li
          class="mm-node"
          style={`--nx: ${(points[i].x / WIDTH) * 100}%; --ny: ${(points[i].y / HEIGHT) * 100}%; --ni: ${i}`}
        >
          <a href={withBase(`/sessions/${node.slug}/`)}>
            <WeekGlyph week={node.week} class="mm-node__glyph" />
            <span class="mm-node__text">
              <span class="mm-node__week">Week {node.week}</span>
              <span class="mm-node__title">{node.title}</span>
              <span class="mm-node__caption">{node.metaphor}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</div>

<script>
  // The trunk's own pulses are decorative motion, not information: anyone
  // who has asked the OS to reduce motion gets a still network, not a
  // slowed one. SMIL animations aren't reachable from CSS, so this is the
  // one place the map needs a script rather than a stylesheet.
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)");
  function applyMotionPreference() {
    document.querySelectorAll<SVGAnimateMotionElement>(".mycelium-map animateMotion").forEach((anim) => {
      anim.setAttribute("dur", reduceMotion.matches ? "0.1s" : anim.dataset.dur ?? "12s");
    });
  }
  document.querySelectorAll<SVGAnimateMotionElement>(".mycelium-map animateMotion").forEach((anim) => {
    anim.dataset.dur = anim.getAttribute("dur") ?? "12s";
  });
  applyMotionPreference();
  reduceMotion.addEventListener("change", applyMotionPreference);

  // Nodes fade and rise in as they cross into view, rather than all sitting
  // fully drawn on page load — the map reveals itself as you descend into
  // it, matching the rest of the homepage's "continuous descent" framing.
  // Reduced motion gets every node visible immediately, no observer needed.
  const nodeEls = document.querySelectorAll<HTMLLIElement>(".mm-node");
  if (reduceMotion.matches) {
    nodeEls.forEach((el) => el.classList.add("mm-node--visible"));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("mm-node--visible");
            observer.unobserve(entry.target);
          }
        }
      },
      { rootMargin: "0px 0px -10% 0px", threshold: 0.2 },
    );
    nodeEls.forEach((el) => observer.observe(el));
  }
</script>

<style>
  .mycelium-map {
    position: relative;
    width: 100%;
    height: var(--map-height);
    margin-block-end: var(--at-spacing-2xl);
    scroll-margin-top: 5rem;
  }

  .mycelium-map__art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* A node near the 18–82% band can still, on a very narrow viewport, ask
     for more card width than the space to the edge — clip rather than let
     it force page-wide horizontal scroll. The clamp above keeps this rare
     and shallow, not the primary defence. */
  .mycelium-map {
    overflow-x: clip;
  }

  .mm-trunk-field {
    fill: none;
    stroke: var(--myco-glow-2);
    stroke-width: 46;
    stroke-linecap: round;
    opacity: 0.07;
    filter: blur(22px);
  }

  .mm-trunk {
    fill: none;
    stroke: var(--at-primary);
    stroke-width: 3;
    stroke-linecap: round;
    opacity: 0.55;
    filter: drop-shadow(0 0 5px var(--myco-glow-soft));
    animation: mm-trunk-breathe 7s ease-in-out infinite;
  }

  .mm-branch {
    fill: none;
    stroke: var(--at-primary);
    stroke-width: 1.6;
    stroke-linecap: round;
    opacity: 0.28;
    filter: drop-shadow(0 0 3px var(--myco-glow-soft));
  }

  .mm-spore {
    fill: var(--at-secondary);
    opacity: 0.4;
    filter: drop-shadow(0 0 4px var(--myco-glow-2));
  }

  .mm-pulse {
    fill: var(--at-secondary);
    filter: drop-shadow(0 0 6px var(--myco-glow)) drop-shadow(0 0 12px var(--myco-glow-soft));
  }

  /* .mm-detritus / .mm-ant are styled globally in mycelium.css now — shared
     with MyceliumHero, which reuses the same <use>-referenced fauna. */

  @keyframes mm-trunk-breathe {
    0%, 100% { filter: drop-shadow(0 0 5px var(--myco-glow-soft)); }
    50% { filter: drop-shadow(0 0 11px var(--myco-glow)); }
  }

  .mycelium-map__nodes {
    position: relative;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mm-node {
    position: absolute;
    left: var(--nx);
    top: var(--ny);
    transform: translate(-50%, -50%);
    translate: 0 1.25rem;
    opacity: 0;
    transition:
      opacity 0.6s ease,
      translate 0.6s ease;
    transition-delay: calc(var(--ni, 0) * 45ms);
  }

  .mm-node--visible {
    translate: 0 0;
    opacity: 1;
  }

  .mm-node a {
    display: flex;
    align-items: center;
    gap: var(--at-spacing-sm);
    padding: var(--at-spacing-xs) var(--at-spacing-sm) var(--at-spacing-xs) var(--at-spacing-xs);
    border-radius: 999px;
    background: var(--at-bg-elevated);
    border: 2px solid var(--at-border);
    box-shadow:
      var(--at-shadow-sm),
      0 0 16px -6px var(--myco-glow-soft);
    color: var(--at-text);
    text-decoration: none;
    max-width: min(58vw, 18rem);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }

  .mm-node a:hover,
  .mm-node a:focus-visible {
    transform: scale(1.05);
    border-color: var(--at-primary);
    box-shadow:
      var(--at-shadow-lg),
      0 0 24px -4px var(--myco-glow);
  }

  .mm-node__glyph {
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    color: var(--at-on-primary);
    border-radius: 999px;
    background: radial-gradient(circle at 32% 28%, var(--myco-glow-2), var(--myco-glow) 55%, var(--at-primary) 100%);
    padding: 0.3rem;
    box-sizing: border-box;
  }

  .mm-node__text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    line-height: 1.2;
    overflow: hidden;
  }

  .mm-node__week {
    font-family: var(--at-font-mono);
    font-size: var(--at-font-size-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--at-text-secondary);
  }

  .mm-node__title {
    font-weight: 700;
    font-size: var(--at-font-size-sm);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mm-node__caption {
    font-size: var(--at-font-size-xs);
    color: var(--at-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mm-node a:hover .mm-node__caption,
  .mm-node a:focus-visible .mm-node__caption {
    color: var(--at-text);
  }

  @media (prefers-reduced-motion: reduce) {
    .mm-node a {
      transition: none;
    }

    .mm-node {
      transition: none;
      opacity: 1;
      translate: 0 0;
    }

    .mm-trunk {
      animation: none;
    }
  }

  @media (max-width: 40rem) {
    .mm-node a {
      max-width: 46vw;
    }

    .mm-node__caption {
      display: none;
    }
  }
</style>
