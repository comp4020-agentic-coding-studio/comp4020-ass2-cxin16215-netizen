---
import BaseLayout from "astro-theme-university/layouts/BaseLayout.astro";
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import FaunaSymbols from "../components/FaunaSymbols.astro";
import MyceliumHero from "../components/MyceliumHero.astro";
import MyceliumMap from "../components/MyceliumMap.astro";
import Stamp from "../components/Stamp.astro";
import { courseMeta } from "../course-config";
import { sessionLabels, siteConfig } from "../site-config";
import "../styles/dossier.css";
import "../styles/mycelium.css";

// A real hero, not ContentLayout's plain-<h1> fallback — this page calls
// BaseLayout directly so MyceliumHero can occupy the theme's own "hero"
// slot with hand-authored SVG rather than a photograph (see CLAUDE.md:
// "no glowing CGI, no stock moss hero" is about generic cliché, not about
// bioluminescence built from this course's own node/trunk system).
---

<BaseLayout
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
  {...siteConfig}
>
  <FaunaSymbols />

  <MyceliumHero
    slot="hero"
    code={courseMeta.code}
    title={courseMeta.title}
    tagline={courseMeta.description}
    mapAnchorId="mycelium-map"
  />

  <p><Stamp label="Case file 6674" rotate={-2} /></p>

  <ul class="course-tags" aria-label="Course tags">
    {courseMeta.tags.map((tag) => <li>{tag}</li>)}
  </ul>

  <p class="map-intro">
    Twelve weeks, one organism. Follow the trunk from Week 1 to the Peace
    Conference, or jump straight to a week's fruiting body below.
  </p>

  <MyceliumMap />

  <h2>What you will do</h2>
  <p>
    Read the forest floor as a diplomatic archive. Each week takes one term
    from statecraft — trade, aid, espionage, sanctions, treaty and betrayal —
    and holds it against a real, citable phenomenon in mycorrhizal biology,
    until the metaphor either earns its keep or breaks. You leave having
    filed a Field Dispatch on a fungal double-cross and argued, in the Peace
    Conference, where the diplomacy framing helped you think and where it
    quietly lied to you.
  </p>

  <h2>Who it is for</h2>
  <p>
    Anyone with a first course in ecology or plant biology who wants to
    practice reading a system for its relationships rather than its parts
    list. No political science background is assumed — the diplomatic
    vocabulary is a lens the course hands you, not a prerequisite. You should
    already be comfortable reading a primary paper; you will read several.
  </p>

  <h2>Where to go next</h2>
  <CardGrid columns={2}>
    <Card title={sessionLabels.plural} href="/sessions/">
      <p>The weekly schedule and what happens in each teaching session.</p>
    </Card>
    <Card title="Assessment" href="/assessments/">
      <p>What is marked, what it is worth, and when it is due.</p>
    </Card>
    <Card title="People" href="/people/">
      <p>Who teaches the course and how to reach them.</p>
    </Card>
  </CardGrid>
</BaseLayout>

<script>
  // Drives --myco-scroll-px (read by mycelium.css's fog/spore layers and by
  // MyceliumHero's own parallax) so the atmosphere visibly deepens as you
  // descend from the hero into the map, rather than sitting static behind a
  // page that just happens to scroll. rAF-throttled; skipped entirely under
  // reduced motion, same gating MyceliumMap already applies to its pulses.
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)");
  let ticking = false;

  function applyScroll() {
    document.documentElement.style.setProperty("--myco-scroll-px", String(window.scrollY));
    ticking = false;
  }

  function onScroll() {
    if (!ticking) {
      requestAnimationFrame(applyScroll);
      ticking = true;
    }
  }

  if (!reduceMotion.matches) {
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>

<style>
  .course-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 0 2rem;
    padding: 0;
    list-style: none;
  }

  .course-tags li {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    color: var(--at-text-secondary);
    background: var(--at-bg-alt);
    font-size: 0.9rem;
  }

  .map-intro {
    color: var(--at-text-secondary);
    font-size: var(--at-font-size-sm);
    max-width: 34rem;
  }
</style>
