---
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import Stamp from "../components/Stamp.astro";
import { courseMeta } from "../course-config";
import { sessionLabels, siteConfig } from "../site-config";
import "../styles/dossier.css";

// No hero photograph: ContentLayout falls back to a plain <h1> when
// heroImage is omitted, which is the point — see CLAUDE.md.
---

<ContentLayout
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
  {...siteConfig}
>
  <p><Stamp label="Case file 6674" rotate={-2} /></p>

  <ul class="course-tags" aria-label="Course tags">
    {courseMeta.tags.map((tag) => <li>{tag}</li>)}
  </ul>

  <h2>What you will do</h2>
  <p>
    Read the forest floor as a diplomatic archive. Each week takes one term
    from statecraft — trade, aid, espionage, sanctions, treaty and betrayal —
    and holds it against a real, citable phenomenon in mycorrhizal biology,
    until the metaphor either earns its keep or breaks. You leave having
    filed a Field Dispatch on a fungal double-cross and argued, in the Peace
    Conference, where the diplomacy framing helped you think and where it
    quietly lied to you.
  </p>

  <h2>Who it is for</h2>
  <p>
    Anyone with a first course in ecology or plant biology who wants to
    practice reading a system for its relationships rather than its parts
    list. No political science background is assumed — the diplomatic
    vocabulary is a lens the course hands you, not a prerequisite. You should
    already be comfortable reading a primary paper; you will read several.
  </p>

  <h2>Where to go next</h2>
  <CardGrid columns={2}>
    <Card title={sessionLabels.plural} href="/sessions/">
      <p>The weekly schedule and what happens in each teaching session.</p>
    </Card>
    <Card title="Assessment" href="/assessments/">
      <p>What is marked, what it is worth, and when it is due.</p>
    </Card>
    <Card title="People" href="/people/">
      <p>Who teaches the course and how to reach them.</p>
    </Card>
  </CardGrid>
</ContentLayout>

<style>
  .course-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 0 2rem;
    padding: 0;
    list-style: none;
  }

  .course-tags li {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    color: var(--at-text-secondary);
    background: var(--at-bg-alt);
    font-size: 0.9rem;
  }
</style>
