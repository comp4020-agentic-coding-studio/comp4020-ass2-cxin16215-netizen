---
import { Image } from "astro:assets";
import BaseLayout from "astro-theme-university/layouts/BaseLayout.astro";
import DossierIndex from "../components/DossierIndex.astro";
import FaunaSymbols from "../components/FaunaSymbols.astro";
import IdleCache from "../components/IdleCache.astro";
import MyceliumMap from "../components/MyceliumMap.astro";
import OpenField from "../components/OpenField.astro";
import { courseFileNo, courseMeta } from "../course-config";
import { sessionLabels, siteConfig } from "../site-config";
import boleteEdulis from "../decks/assets/ecm-boletus-edulis-krisp.jpg";
import pineEcm from "../decks/assets/ecm-lactarius-pinus.jpg";
import "../styles/dossier.css";
import "../styles/mycelium.css";

const colon = courseMeta.title.indexOf(":");
const displayTitle = colon > 0 ? courseMeta.title.slice(0, colon) : courseMeta.title;
const displayDeck = colon > 0 ? courseMeta.title.slice(colon + 1).trim() : courseMeta.description;
---

<BaseLayout
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
  {...siteConfig}
>
  <FaunaSymbols />
  <IdleCache />

  <OpenField
    slot="hero"
    src={boleteEdulis}
    alt="Two Boletus edulis fruiting bodies on oak leaf litter, one fallen to show the pore surface."
    code={courseMeta.code}
    title={displayTitle}
    deck={displayDeck}
    credit="Holger Krisp · CC BY 3.0 · Wikimedia Commons"
    continueHref="#the-brief"
  />

  <section class="folio-statement" id="the-brief">
    <p class="folio-kicker">Case file {courseFileNo} · {courseMeta.session} {courseMeta.year}</p>
    <p class="folio-lede">Read the forest floor as a diplomatic archive.</p>
    <p>
      Each week takes one term from statecraft — trade, aid, espionage, sanctions,
      treaty and betrayal — and holds it against a real, citable phenomenon in
      mycorrhizal biology, until the metaphor either earns its keep or breaks.
      You leave having filed a Field Dispatch on a fungal double-cross and
      argued, in the Peace Conference, where the diplomacy framing helped you
      think and where it quietly lied to you.
    </p>
  </section>

  <section class="hypha-run" id="the-organism" aria-labelledby="the-organism-title">
    <p class="folio-kicker">The organism</p>
    <p class="folio-lede" id="the-organism-title">Twelve weeks, one trunk.</p>
    <p class="hypha-run__deck">
      Follow the hypha from Credentials to the Peace Conference. Each fruiting
      body is a week; the trunk is the argument the course is growing, not a
      timetable laid on its side.
    </p>
    <MyceliumMap />
  </section>

  <figure class="folio-bleed">
    <Image
      src={pineEcm}
      alt="Forked, swollen pine root tips sheathed by Lactarius deliciosus ectomycorrhizae."
      widths={[768, 1536, 2560]}
      sizes="100vw"
    />
    <figcaption>
      <span class="folio-bleed__caption">
        Lactarius on pine: a mantle you can see, a Hartig net you have to
        section for. Proximity in a photograph is not a credential.
      </span>
      <span class="folio-bleed__credit">Marc-André Selosse · CC0 · Wikimedia Commons</span>
    </figcaption>
  </figure>

  <section class="folio-statement">
    <p class="folio-kicker">Who it is for</p>
    <p class="folio-lede">A first course in ecology is enough. Political science is not assumed.</p>
    <p>
      The diplomatic vocabulary is a lens the course hands you, not a
      prerequisite. You should already be comfortable reading a primary paper;
      you will read several.
    </p>
  </section>

  <h2 id="on-file">On file</h2>
  <DossierIndex
    labelledBy="on-file"
    items={[
      {
        href: "/sessions/",
        index: "01",
        title: sessionLabels.plural,
        caption: "The twelve-week teaching schedule: what happens in each field window, and what leaves the room.",
        captionLabel: "",
      },
      {
        href: "/lectures/",
        index: "02",
        title: "Dispatches",
        caption: "What is covered, week by week, and which topics each lecture draws on.",
        captionLabel: "",
      },
      {
        href: "/assessments/",
        index: "03",
        title: "Returns",
        caption: "What is marked, what it is worth, and when it is due.",
        captionLabel: "",
      },
      {
        href: "/people/",
        index: "04",
        title: "Personnel",
        caption: "Who teaches the course and how to reach them.",
        captionLabel: "",
      },
    ]}
  />
</BaseLayout>

<script>
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)");
  let ticking = false;

  function applyScroll() {
    document.documentElement.style.setProperty("--myco-scroll-px", String(window.scrollY));
    ticking = false;
  }

  function onScroll() {
    if (!ticking) {
      requestAnimationFrame(applyScroll);
      ticking = true;
    }
  }

  if (!reduceMotion.matches) {
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>

<style>
  .hypha-run {
    padding-block-start: clamp(4rem, 12vw, 8rem);
    scroll-margin-top: calc(var(--at-nav-height, 5.5rem) + 1rem);
  }

  .hypha-run .folio-kicker,
  .hypha-run .folio-lede,
  .hypha-run__deck {
    margin-inline: max(var(--at-gutter, 1.5rem), calc((100vw - 42rem) / 2));
  }

  .hypha-run__deck {
    max-width: 36rem;
    margin-block: 0 var(--at-spacing-xl);
    color: var(--at-text-secondary);
  }
</style>
